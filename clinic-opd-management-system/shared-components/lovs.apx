lov med-frequency (
    name: MED FREQUENCY
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: 1+1+1
        return: 1+1+1
    )

    entry lov_data-10 (
        sequence: 10
        display: 0+1/2+1/2
        return: 0+1/2+1/2
    )

    entry lov_data-2 (
        sequence: 2
        display: 0+1+0
        return: 0+1+0
    )

    entry lov_data-3 (
        sequence: 3
        display: 1+0+0
        return: 1+0+0
    )

    entry lov_data-4 (
        sequence: 4
        display: 0+0+1
        return: 0+0+1
    )

    entry lov_data-5 (
        sequence: 5
        display: 1+0+1
        return: 1+0+1
    )

    entry lov_data-6 (
        sequence: 6
        display: 1+1+0
        return: 1+1+0
    )

    entry lov_data-7 (
        sequence: 7
        display: 0+1+1
        return: 0+1+1
    )

    entry lov_data-8 (
        sequence: 8
        display: 1/2+1/2+1/2
        return: 1/2+1/2+1/2
    )

    entry lov_data-9 (
        sequence: 9
        display: 1/2+0+1/2
        return: 1/2+0+1/2
    )

)

lov medicines (
    name: MEDICINES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT MED_NAME||'('||MED_TYPE||')-'||GENERIC_NAME D, MED_ID R
            FROM MEDICINE_INFO M JOIN GENERIC_INFO G
            ON(M.GENERIC_ID = G.GENERIC_ID)
            
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

