lov access-roles (
    name: ACCESS_ROLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select role_name d, role_id r
            from APEX_APPL_ACL_ROLES where application_id = :APP_ID 
            order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov advices (
    name: ADVICES
    source {
        type: sqlQuery
        sqlQuery: SELECT ADV_NAME D, ADV_ID R FROM ADVICE_INFO
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

lov appointment-info-app-mobile-no (
    name: APPOINTMENT_INFO.APP_MOBILE_NO
    source {
        tableName: APPOINTMENT_INFO
    }
    columnMapping {
        return: APP_ID
        display: APP_MOBILE_NO
        defaultSort: APP_MOBILE_NO
    }
)

lov blood-group (
    name: BLOOD GROUP
    source {
        location: staticValues
    }

    entry a (
        sequence: 1
        display: A+
        return: A+
    )

    entry a-2 (
        sequence: 2
        display: A-
        return: A-
    )

    entry ab (
        sequence: 5
        display: AB+
        return: AB+
    )

    entry ab-2 (
        sequence: 6
        display: AB-
        return: AB-
    )

    entry b (
        sequence: 3
        display: B+
        return: B+
    )

    entry b-2 (
        sequence: 4
        display: B-
        return: B-
    )

    entry o (
        sequence: 7
        display: O+
        return: O+
    )

    entry o-2 (
        sequence: 8
        display: O-
        return: O-
    )

)

lov departments (
    name: DEPARTMENTS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT dept_name AS D, dept_id AS R
            FROM departments_info
            ORDER BY dept_NAME ASC;
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov desktop-theme-styles (
    name: DESKTOP THEME STYLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select s.name d,
                s.theme_style_id r
            from apex_application_theme_styles s, apex_application_themes t
            where s.application_id = t.application_id
                and s.theme_number = t.theme_number
                and s.application_id = :app_id
                and t.ui_type_name   = 'DESKTOP'
                and t.is_current = 'Yes'
            order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

