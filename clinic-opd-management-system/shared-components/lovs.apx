lov employees (
    name: EMPLOYEES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select emp_id||'-'||Emp_name d, emp_id r
            from employees_info
            order by 2 asc;
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

lov feedback-rating (
    name: FEEDBACK_RATING
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: Positive
        return: 3
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-smile-o fa-2x feedback-positive" aria-hidden="true" ></span></span>
        }
    )

    entry lov_data-2 (
        sequence: 2
        display: Neutral
        return: 2
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-emoji-neutral fa-2x feedback-neutral" aria-hidden="true" ></span></span>
        }
    )

    entry lov_data-3 (
        sequence: 3
        display: Negative
        return: 1
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-frown-o fa-2x feedback-negative" aria-hidden="true" ></span></span>
        }
    )

)

lov feedback-status (
    name: FEEDBACK_STATUS
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: No Action
        return: 0
    )

    entry lov_data-2 (
        sequence: 2
        display: Acknowledged
        return: 1
    )

    entry lov_data-3 (
        sequence: 3
        display: Open
        return: 3
    )

    entry lov_data-4 (
        sequence: 4
        display: Closed
        return: 4
    )

)

