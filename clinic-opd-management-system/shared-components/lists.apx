list custom-menu (
    name: custom menu
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT level ,
            M.MENU_NAME label,
            decode(connect_by_isleaf, 0, '','f?p=&APP_ID.:' || TO_CHAR(M.APEX_PAGE_NO) ||
            ':&SESSION.:::::' ) target,
            'YES' is_current,
            nvl('','fa-apex-square') image,
            M.PARENT_MENU
            FROM MENU M 
            WHERE MENU_CODE IN (SELECT MENU_CODE FROM Group_Menu GM  JOIN USER_GROUP U ON (GM.GROUP_ID =  U.USER_GROUP_ID) WHERE MENU_CODE = M.MENU_CODE 
            AND U.USER_ID = :SESSION_GROUP_ID
            )
            START WITH PARENT_MENU IS NULL
            CONNECT BY
            PRIOR menu_code = PARENT_MENU
            ORDER SIBLINGS BY PARENT_MENU||M.MENU_CODE;
            ```
    }

    entry appointment-management (
        label: Appointment Management
        icon {
            imageIconCssClasses: fa-forms
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: pages
            pages: 69
        }
        link {
            target: {
                page: 69
            }
        }
    )

)

list desktop-navigation-bar (
    name: Desktop Navigation Bar

    entry about (
        label: About
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 20
        }
        userDefinedAttributes {
            2: icon-only
        }
        config {
            buildOption: @feature-about-page
        }
    )

    entry about-page (
        label: About Page
        icon {
            imageIconCssClasses: fa-info-circle-o
        }
        layout {
            sequence: 50
            parentEntry: @about
        }
        link {
            target: {
                page: 10060
                clearCache: 10060
            }
        }
        config {
            buildOption: @feature-about-page
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry feedback (
        label: Feedback
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10050
                items: {
                    P10050_PAGE_ID: &APP_PAGE_ID.
                }
                clearCache: 10050
                action: resetPagination
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        config {
            buildOption: @feature-feedback
        }
    )

    entry install-app (
        label: Install App
        icon {
            imageIconCssClasses: fa-cloud-download
        }
        layout {
            sequence: 1
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #action$a-pwa-install
            }
        }
        userDefinedAttributes {
            2: a-pwaInstall
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 40
            parentEntry: @about
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry list_item-2 (
        label: ---
        layout {
            sequence: 70
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry page-help (
        label: Page Help
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 30
            parentEntry: @about
        }
        link {
            target: {
                page: 10061
                items: {
                    P10061_PAGE_ID: &APP_PAGE_ID.
                }
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        config {
            buildOption: @feature-about-page
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 80
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

