customAttribute attribute_01 (
    apexlangName: configjson
    attribute: 1
    name: ConfigJSON
    type: javaScriptCode
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value:
            ```
            {
              "cardWidth": 4,
              "refresh": 20
            }
            ```
    }
    help {
        helpText:
            ```
            <pre>
            {
              "cardWidth": 4,
              "refresh": 0
            }
            </pre>
            <br>
            <h3>Explanation:</h3>
              <dl>
              <dt>cardWidth (number)</dt>
              <dd>width per card between 1 and 12</dd>
              <dl>
              <dt>refresh (number)</dt>
              <dd>wrefresh time of cards in seconds if 0 then no refresh will be set</dd>
            ```
    }
)

