        componentAppearance {
            gridColumns: 3
        }
        title {
            column: ADAY
        }
    )

    region doctor-available-on (
        name: Doctor Available on
        title: <p align=center>Doctor Available on</p>
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                 V_OUTPUT CLOB; 
                
                V_AVAILABLE_DAY VARCHAR2(100);
                CURSOR DOC_AV_DAYS(P_DOC_ID IN NUMBER) IS 
                                        
                                        SELECT ADAY FROM (
                                        SELECT 'Saturday' ADAY, 1 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND SAT = 1
                                        UNION
                                        SELECT 'Sunday' ADAY, 2 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND SUN = 1
                                        UNION
                                        SELECT 'Monday' ADAY, 3 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND MON = 1
                                        UNION
                                        SELECT 'Tuesday' ADAY, 4 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND TUE = 1
                                        UNION
                                        SELECT 'Wednesday' ADAY, 5 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND WED = 1
                                        UNION
                                        SELECT 'Thursday' ADAY, 6 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND THU = 1
                                        UNION
                                        SELECT 'Friday' ADAY, 7 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND FRI = 1)
                                        ORDER BY SL ASC;
                BEGIN
                 
                 FOR i IN DOC_AV_DAYS(P_DOC_ID => :P31_DOCTOR_NO) LOOP
                    V_AVAILABLE_DAY := V_AVAILABLE_DAY ||' '||i.ADAY;
                 END LOOP;
                
                V_OUTPUT := '<SPAN>Doctor Available on: <b style="color: blue;">'||V_AVAILABLE_DAY||'</b></SPAN>';
                
                RETURN V_OUTPUT;
                END;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @appointment-entry
            slot: subRegions
            column: 7
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                margin-bottom-none
            ]
        }
        serverSideCondition {
            type: never
        }
    )

