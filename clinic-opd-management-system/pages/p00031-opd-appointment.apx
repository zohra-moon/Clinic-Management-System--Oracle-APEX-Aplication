    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P31_DOB
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Function to calculate age in years, months, and days
                    function calculateAge(dob) {
                        let birthDate = new Date(dob);
                        let today = new Date();
                        
                        let years = today.getFullYear() - birthDate.getFullYear();
                        let months = today.getMonth() - birthDate.getMonth();
                        let days = today.getDate() - birthDate.getDate();
                        
                        // Adjust months and years if necessary
                        if (days < 0) {
                            months--; // Borrow a month
                            let previousMonth = new Date(today.getFullYear(), today.getMonth(), 0);
                            days += previousMonth.getDate();
                        }
                    
                        if (months < 0) {
                            years--; // Borrow a year
                            months += 12;
                        }
                    
                        return `${years} Years, ${months} Months, ${days} Days`;
                    }
                    
                    // Get the DOB value from APEX Item
                    let dobValue = $v("P31_DOB"); // Change "P1_DOB" to your actual item name
                    
                    if (dobValue) {
                        let ageText = calculateAge(dobValue);
                    
                        // Set the calculated age text into the APEX page item
                        $s("P31_AGE", ageText); // Change "P1_AGE" to your actual item name
                    }
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: [
                    P31_AGE
                    P31_DOB
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P31_AGE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

