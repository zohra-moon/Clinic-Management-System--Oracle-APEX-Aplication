    validation doc-av-day-check (
        name: DOC AV DAY CHECK
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE 
                 V_PICKED_DAY VARCHAR2(5) := TO_CHAR(TO_DATE(:P31_APP_DATE,'MM/DD/YYYY'),'DY');
                 V_DOC_ID NUMBER := :P31_DOCTOR_NO;
                 V_COUNTER NUMBER := 0;
                 CURSOR DOC_AV_DAYS(P_DOC_ID IN NUMBER) IS 
                                        SELECT 'SAT' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND SAT = 1
                                        UNION
                                        SELECT 'SUN' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND SUN = 1
                                        UNION
                                        SELECT 'MON' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND MON = 1
                                        UNION
                                        SELECT 'TUE' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND TUE = 1
                                        UNION
                                        SELECT 'WED' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND WED = 1
                                        UNION
                                        SELECT 'THU' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND THU = 1
                                        UNION
                                        SELECT 'FRI' ADAY
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = P_DOC_ID
                                        AND FRI = 1;
                BEGIN
                
                
                 FOR i IN DOC_AV_DAYS(  P_DOC_ID=>V_DOC_ID) LOOP
                  IF V_PICKED_DAY = i.ADAY THEN
                     V_COUNTER := 1; 
                   END IF;
                 END LOOP;
                
                
                IF V_COUNTER = 0 THEN
                   RETURN 'Doctor Not Available on Selected Day!';
                END IF;
                
                END;
                ```
            alwaysExecute: true
        }
        error {
            displayLocation: inlineWithField
            associatedItem: @P31_APP_DATE
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process dml-appointment (
        name: DML Appointment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                 v_pk number;
                 v_reg_pk number;
                 V_SL NUMBER;
                 V_CHK NUMBER :=0;
                begin
                  select nvl(max(app_ID),9999)+1 into v_pk
                  from appointment_INFO;
                  
                 SELECT NVL (MAX (APP_SERIAL_NO), 0) + 1 INTO V_SL
                            FROM APPOINTMENT_INFO
                            WHERE DOC_ID = :P31_DOCTOR_NO
                           AND APP_DATE_TIME = :P31_APP_DATE ;
                :G_APPOINT_ID :=V_PK;
                ------------------------------------New patient----------------------
                 IF  :P31_P_REG_ID is null THEN
                   	SELECT NVL(MAX(P_REG_ID), 0) + 1 
                   INTO v_reg_pk
                   FROM PATIENTS_REG_INFO;
                   
                      INSERT INTO PATIENTS_REG_INFO (P_REG_ID, P_NAME, MOBILE_NO, DATE_OF_BIRTH, GENDER, email)
                      VALUES ( v_reg_pk, :P31_PAT_NAME, :P31_APP_MOBILE_NO, :P31_DOB, :P31_GENDER, :P31_EMAIL);
                
                   else 
                   v_reg_pk:= :P31_P_REG_ID;
                   END IF;
                   
                
                
                   ----------------CHECK IF THE RECORD IS EXIST IN DB------------------------------
                    BEGIN
                    SELECT COUNT(*) INTO V_CHK
                    FROM APPOINTMENT_INFO
                    WHERE APP_id = :P31_APP_ID;
                    EXCEPTION
                     WHEN OTHERS THEN
                      V_CHK := 0;
                    END;
                
                IF V_CHK = 0 THEN
                insert into APPOINTMENT_INFO(
                        APP_ID,
                       APP_DATE_TIME,
                          APP_SERIAL_NO,
                       P_REG_ID,
                       DOC_ID,
                       APP_MOBILE_NO,
                       PATIENT_TYPE,
                    
                       NOTE,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                       DEPT_ID
                )
                 values (
                        v_pk,
                        :P31_APP_DATE,
                        V_SL,
                        v_reg_pk,
                        :P31_DOCTOR_NO,
                        :P31_APP_MOBILE_NO,
                        :P31_PAT_TYPE,
                        :P31_NOTE,
                        :P27_STATUS,    
                         v('APP_USER'),      
                         SYSDATE,
                         :P31_DEPT_NO
                
                 );
                
                
                declare
                v_doc varchar2(100);
                BEGIN
                select doc_name into v_doc
                from doctors_info  where doc_id=:P31_DOCTOR_NO;
                    APEX_MAIL.SEND(
                        p_to        => :P31_EMAIL,
                       p_from      => 'zohramoon10@gmail.com',
                        p_subj      => 'Appointment Booking Confirmation',
                        p_body      => 'Greetings '||:P31_PAT_NAME||',
                                        Your Appointment has been booked with'||v_doc||' on '||:P31_APP_DATE||'.
                                        serial no: '||V_SL||'.
                                        Thank You for choosing Green Heart Clinic.'
                    );
                    
                    COMMIT;  -- Required to process email
                END;
                
                
                
                
                END IF;
                
                
                
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Appointment Booked!
        }
        error {
            errorMessage: Couldn't book the Appointment
        }
        advanced {
            executionMappingIdentifier: 13151680554876962903
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

