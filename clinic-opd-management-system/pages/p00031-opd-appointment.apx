    region doc-avail-cards (
        name: doc_avail_cards
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ADAY FROM (
                                        SELECT 'Saturday' ADAY, 1 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND SAT = 1
                                        UNION
                                        SELECT 'Sunday' ADAY, 2 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND SUN = 1
                                        UNION
                                        SELECT 'Monday' ADAY, 3 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND MON = 1
                                        UNION
                                        SELECT 'Tuesday' ADAY, 4 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND TUE = 1
                                        UNION
                                        SELECT 'Wednesday' ADAY, 5 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND WED = 1
                                        UNION
                                        SELECT 'Thursday' ADAY, 6 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND THU = 1
                                        UNION
                                        SELECT 'Friday' ADAY, 7 SL
                                        FROM DOCS_AV_DAY
                                        WHERE DOC_ID = :P31_DOCTOR_NO
                                        AND FRI = 1)
                                        ORDER BY SL ASC;
                ```
        }
        layout {
            sequence: 30
            parentRegion: @appointment-entry
            slot: subRegions
            column: 7
        }
        appearance {
