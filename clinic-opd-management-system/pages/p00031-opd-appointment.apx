    dynamicAction add-to-nurse-st (
        name: ADD TO NURSE ST
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P31_APP_CONFIRM
        }

        action native-alert (
            action: alert
            settings {
                message: Are you sure you want to confirm this visit?
                style: warning
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                    	V_NURSE_ST_ID NUMBER;
                    
                    BEGIN
                    	SELECT NVL((MAX(NURSE_ST_ID)),0)+1 INTO V_NURSE_ST_ID FROM NURSE_STATION;
                    
                    	 INSERT INTO NURSE_STATION (NURSE_ST_ID, VISIT_DATE, IN_FLAG, APP_ID)
                       VALUES (V_NURSE_ST_ID, SYSDATE, 1, :P31_APP_CONFIRM  
                    );
                    end;
                    ```
                itemsToSubmit: P31_APP_CONFIRM
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.confirm("Are you sure you want to confirm this visit?", function(okPressed) {
                        if (okPressed) {
                            apex.server.process("CONFIRM_VISIT"); // Call APEX Process to confirm visit
                            apex.message.alert("The patient's visit has been confirmed successfully.");
                        }
                    });
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @queue
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

