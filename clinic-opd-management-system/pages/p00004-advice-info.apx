page 4 (
    name: Advice Info
    alias: ADVICE-INFO
    title: Advice Information
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            #bg_one {
                background-color: #EADDCA;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region advice-information (
        name: Advice Information
        type: form
        source {
            location: localDatabase
            tableName: ADVICE_INFO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: bg_one
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P4_ADV_ID (
        type: hidden
        layout {
            sequence: 10
            region: @advice-information
            slot: regionBody
        }
        source {
            formRegion: @advice-information
            column: ADV_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P4_ADV_NAME (
        type: textarea
        label {
            label: Adv Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @advice-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @advice-information
            column: ADV_NAME
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_INSERT_BY (
        type: hidden
        layout {
            sequence: 40
            region: @advice-information
            slot: regionBody
        }
        source {
            formRegion: @advice-information
            column: INSERT_BY
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_INSERT_DATE (
        type: hidden
        layout {
            sequence: 50
            region: @advice-information
            slot: regionBody
        }
        source {
            formRegion: @advice-information
            column: INSERT_DATE
            dataType: date
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_STATUS (
        type: hidden
        layout {
            sequence: 30
            region: @advice-information
            slot: regionBody
        }
        source {
            formRegion: @advice-information
            column: STATUS
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_UPDATE_BY (
        type: hidden
        layout {
            sequence: 60
            region: @advice-information
            slot: regionBody
        }
        source {
            formRegion: @advice-information
            column: UPDATE_BY
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P4_UPDATE_DATE (
        type: hidden
        layout {
            sequence: 70
            region: @advice-information
            slot: regionBody
        }
        source {
            formRegion: @advice-information
            column: UPDATE_DATE
            dataType: date
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_ADV_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_ADV_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_ADV_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 12963717912681961524
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process gen-pk (
        name: gen_pk
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select nvl(max(adv_id),999)+1, sysdate, v('app_user') into :P4_ADV_ID, :P4_INSERT_DATE, :P4_INSERT_BY
                from advice_info;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12963066268802045671
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process initialize-form-advice-setup (
        name: Initialize form Advice Setup
        type: formInitialization
        formRegion: @advice-information
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12963717132403961524
        }
    )

    process process-form-advice-setup (
        name: Process form Advice Setup
        type: formAutoRowProcessing
        formRegion: @advice-information
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12963717530440961524
        }
    )

)

