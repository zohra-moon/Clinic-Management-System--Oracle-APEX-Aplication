                       QUANTIY,
                       DISCOUNT_PCT,
                       NET_AMOUNT,
                       APP_ID APPID, app_id Appoint_ID,
                       NURSE_ST_ID,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                       UPDATE_BY,
                       UPDATE_DATE,
                       DOC_ID,
                       TOTAL,
                       DISC_AMT,
                       RECEIVED_AMT,
                       DUE_RETURN_AMT, 'pay' pay
                  from BILLING
                 where DUE_RETURN_AMT>0
                    order by 1 desc;
                ```
        }
        layout {
            sequence: 30
            parentRegion: @bills
            slot: subRegions
        }
        appearance {
