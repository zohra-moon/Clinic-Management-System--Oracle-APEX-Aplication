    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if :P34_DUE_AMT >0 then
                
                   RETURN 'Payment is Due!';
                END IF;
                ```
            alwaysExecute: true
        }
        error {
            associatedItem: @P34_DUE_AMT
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process dml-on-billing (
        name: dml on billing
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                 v_pk number;
                
                begin
                  select nvl(max(BILL_ID),9999)+1 into v_pk
                  from BILLING;
                  
                
                :G_INVOICE_ID:= V_PK;
                   ----------------CHECK IF THE RECORD IS EXIST IN DB------------------------------
                
                
                insert into billing(
                        BILL_ID,
                       BILL_DATE,
                       DISCOUNT_PCT,
                       NET_AMOUNT,
                       APP_ID,
                       NURSE_ST_ID,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                     
                      DOC_ID,
                       TOTAL,
                   
                       DISC_AMT,
                       RECEIVED_AMT,
                       DUE_RETURN_AMT
                
                )
                 values (
                        v_pk,
                        :P34_BILL_DATE,
                       :P34_DISCOUNT_PCT,
                       :P34_NET_AMOUNT,
                       :P34_APPID,
                       :P34_NURSE_ST_ID,
                       'Y',
                         v('APP_USER'),
                         sysdate,
                         :P34_DOC_ID,
                         :P34_TOTAL,
                        
                          :P34_DISC_AMT,
                         :P34_RECEIVED_AMT,
                         :P34_DUE_AMT
                        
                        
                 );
                
                update NURSE_STATION
                set BILLING_FLAG ='P'
                where app_id= :P34_APPID ;
                
                
                end;
                
                
                ```
        }
        execution {
            sequence: 5
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 5861011674941317916
        }
    )

