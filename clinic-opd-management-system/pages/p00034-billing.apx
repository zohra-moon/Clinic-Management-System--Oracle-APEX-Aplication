    region payment (
        name: Payment
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @bill-entry
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--accent1
                t-Region--stacked
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
        }
    )

    region pending-bills (
        name: Pending Bills
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROW_NUMBER() OVER(ORDER BY app_id desc) SL,
                 APP_SERIAL_NO,
                       APP_MOBILE_NO,
                       P_NAME,
                       DOC_NAME,
                       SHIFT_NAME,
                       APP_ID appID,
                       START_TIME,
                       END_TIME,
                       X,
                       DOC_ID,
                       PATIENT_TYPE,
                       NURSE_ST_ID,
                       'pay' pay
                
                  from BILLINGVIEW
                order by appid desc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @bills
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
