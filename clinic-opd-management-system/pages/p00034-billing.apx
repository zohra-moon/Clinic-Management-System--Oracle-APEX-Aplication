    dynamicAction fetch-doc-rate (
        name: fetch doc rate
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P34_DOC_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     :P34_DISC_AMT := (NVL(:P34_NET_AMOUNT,0) * NVL(:P34_DISCOUNT_PCT,0))/100;
                    
                     :P34_TOTAL := NVL(:P34_NET_AMOUNT,0) - NVL(:P34_DISC_AMT,0);
                    
                      :P34_DUE_AMT := NVL(:P34_TOTAL,0) - NVL(:P34_DISC_AMT,0) - NVL(:P34_RECEIVED_AMT,0);
                    ```
                itemsToSubmit: [
                    P34_NET_AMOUNT
                    P34_DISCOUNT_PCT
                    P34_DISC_AMT
                    P34_TOTAL
                    P34_RECEIVED_AMT
                ]
                itemsToReturn: [
                    P34_DISC_AMT
                    P34_TOTAL
                    P34_DUE_AMT
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var value1 = parseFloat($v("P34_NET_AMOUNT")) || 0;
                    var value2 = parseFloat($v("P34_DISCOUNT_PCT")) || 0;
                    var value3 = parseFloat($v("P34_RECEIVED_AMT")) || 0;
                    var DISC = (value1 * value2)/100;
                    var total= (value1 - DISC);
                    var due=(total- value3 )
                    $s("P34_DISC_AMT", DISC);
                    $s("P34_TOTAL", total);
                    $s("P34_DUE_AMT", due);
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select RATE
                    from 
                    DOC_SERVICES
                    where doc_id = :P34_DOC_ID
                    and Patient_type= :P34_PAT_TYPE;
                    ```
                itemsToSubmit: [
                    P34_DOC_ID
                    P34_PAT_TYPE
                ]
            }
            affectedElements {
                selectionType: items
                items: P34_NET_AMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fetch-patient (
        name: fetch patient
        execution {
            sequence: 10
        }
        when {
            selectionType: items
