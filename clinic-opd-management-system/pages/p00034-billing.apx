page 34 (
    name: Billing
    alias: BILLING
    title: Billing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* General Page Styling */
            .t-Body-mainContent {
                background: #FEFBE0;
                color: #004d40;
            }
            
            /* Static Region Styling */
            .t-Region {
                background: #e2ece9;
                border-radius: 10px;
                padding: 14px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Table Styling */
            .t-IRR-table, .a-IG-table {
                background: e2ece9;
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #B6D0E2;
            }
            .t-Report-report td, .a-IRR-table td, .a-IG-table td {
                border: 1px solid #B6D0E2;
                padding: 12px;
                color: #0f0d0d;
            }
            
            /* Toolbar Styling */
            .a-IRR-toolbar {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Buttons */
            .t-Button, #save, #btn_submit, #update {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                color: #030202;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                transition: 0.3s;
            }
            .t-Button:hover, #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
            }
            #close, #btn_cancel {
                background: linear-gradient(135deg, #FFAAAA, #FF6666);
                color: white;
            }
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(135deg, #FF6666, #CC4444);
            }
            
            /* Input Fields */
            .input-container input, .input-container select {
                width: 100%;
                background: #f6dede;
                border: 1px solid #B6D0E2;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #222121;
            }
            
            /* Modal/Dialog */
            .ui-dialog {
                background: #FFFFFF;
                border-radius: 10px;
                padding: 16px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 12px rgba(182, 208, 226, 0.5);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
               /* padding: 8px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
               /* padding: 12px 16px;*/
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                /*padding: 10px 14px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #e2ece9;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            
            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-thumb {
                background: #B6D0E2;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #A0B8C8;
            }
            
            /* Hover Effects */
            .t-Report-report tr:hover td, .a-IRR-table tr:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            
            /* Breadcrumb Bar Styling */
            .t-BreadcrumbRegion {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 8px;
                padding: 10px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 2px 6px rgba(182, 208, 226, 0.5);
            }
            .t-BreadcrumbRegion .t-Breadcrumb-label {
                color: #000000;
                font-weight: bold;
            }
            .t-BreadcrumbRegion a {
                color: #006064;
                text-decoration: none;
                transition: 0.3s;
            }
            .t-BreadcrumbRegion a:hover {
                color: #004d40;
                text-decoration: underline;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bill-entry (
        name: Bill Entry
        type: staticContent
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            column: 9
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent2
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
        }
    )

    region bills (
        name: bills
        type: regionDisplaySelector
        layout {
            sequence: 10
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        settings {
            displayRegionIcons: true
            includeShowAll: false
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region completed-bills (
        name: Completed bills
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select BILL_ID,
                       BILL_DATE,
                       SERVICE_ID,
                       QUANTIY,
                       DISCOUNT_PCT,
                       NET_AMOUNT,
                       APP_ID, app_id Appoint_ID,
                       NURSE_ST_ID,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                       UPDATE_BY,
                       UPDATE_DATE,
                       DOC_ID,
                       TOTAL,
                       DISC_AMT,
                       RECEIVED_AMT,
                       DUE_RETURN_AMT, 'Invoice' invoice
                  from BILLING
                 where DUE_RETURN_AMT<=0
                    order by 1 desc;
                ```
        }
        layout {
            sequence: 40
            parentRegion: @bills
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column APPOINT_ID (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column APP_ID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Patient
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select p.p_name, a.app_id
                     from  patients_reg_info p join appointment_info a
                     on(p.p_reg_id= a.p_reg_id);
                    ```
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column BILL_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Bill Date
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column BILL_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Invoice ID
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column DISCOUNT_PCT (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column DISC_AMT (
            reportColumnQueryId: 17
            derivedColumn: N
            heading {
                heading: Discount Amt.
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column DOC_ID (
            reportColumnQueryId: 15
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Doctor
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @doctors-info-doc-name
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column DUE_RETURN_AMT (
            reportColumnQueryId: 19
            derivedColumn: N
            heading {
                heading: Due/Return
                alignment: end
            }
            layout {
                sequence: 200
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column INSERT_BY (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column INSERT_DATE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column INVOICE (
            reportColumnQueryId: 20
            derivedColumn: N
            type: link
            heading {
                heading: Invoice
                alignment: center
            }
            layout {
                sequence: 210
                columnAlignment: center
            }
            link {
                target: {
                    page: 39
                    items: {
                        P39_BILL_ID: #BILL_ID#
                    }
                }
                linkText: <span class="fa fa-print" aria-hidden="true"></span>
            }
            sorting {
                sortable: false
            }
        )

        column NET_AMOUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Net Amount
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column NURSE_ST_ID (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

        column QUANTIY (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column RECEIVED_AMT (
            reportColumnQueryId: 18
            derivedColumn: N
            heading {
                heading: Received Amt.
                alignment: end
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column SERVICE_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column STATUS (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

        column TOTAL (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

    )

    region due-bills (
