page 29 (
    name: Role Information
    alias: ROLE-INFORMATION
    title: Role Information
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            /* ===== ¿ General Page Styling ===== */
            .t-Body-mainContent {
                flex-grow: 1;
                background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            }
               .t-Region-title {
                color: white !important;
            }
            .t-IRR-table, 
            .a-IG-table {
                background: rgba(255, 255, 255, 0.15); /* Light Transparent White */
                border-radius: 12px;
                padding: 14px;
                box-shadow: 0 5px 20px rgba(0, 247, 255, 0.3);
            }
            
            /* ===== ¿ Table Cell Borders & Styling ===== */
            .t-Report-report td, 
            .a-IRR-table td, 
            .a-IG-table td {
                border: 1px solid rgba(0, 247, 255, 0.4);
                padding: 12px;
                font-size: 15px;
                color: #e0ffff; /* Light Cyan */
            }
            
            /* ===== ¿ Report Headers (Bold & Transparent) ===== */
            .a-IRR-header, 
            .a-IRR-header:hover, 
            .t-Report-colHead {
                font-weight: bold;
                color: #001f3f;
                background: rgba(0, 247, 255, 0.8); /* Cyan with Transparency */
                height: 36px;
                border-radius: 6px;
                text-transform: uppercase;
            }
            
            /* ===== ¿ Buttons Styling ===== */
            #save, #btn_submit, #update {
                background: linear-gradient(310deg, #00f7ff, #009688);
                color: white;
                border-radius: 8px;
                font-weight: bold;
                padding: 12px 16px;
                border: none;
                cursor: pointer;
                box-shadow: 0 4px 12px rgba(0, 247, 255, 0.4);
                transition: 0.3s ease;
            }
            
            #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(310deg, #009688, #0055cc);
            }
            
            /* ===== ¿ Close/Cancel Buttons ===== */
            #close, #btn_cancel {
                background: linear-gradient(310deg, #ff0033, #661111);
                transition: 0.3s ease;
            }
            
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(310deg, #cc0022, #550000);
            }
            
            /* ===== ¿ Input Container to Hold Label & Input ===== */
            .input-container {
                position: relative;
                width: 100%;
                margin-bottom: 20px; /* Adds space below inputs */
            }
            
            /* ===== ¿ Floating Label Style ===== */
            .input-container label {
                position: absolute;
                top: 50%;
                left: 14px;
                transform: translateY(-50%);
                font-size: 16px;
               font-weight: bold;
                color: rgba(255, 255, 255, 0.9);
                transition: all 0.3s ease;
                pointer-events: none; /* Prevents clicking the label */
            }
            
            /* ===== ¿ Input Field with Floating Label ===== */
            .input-container input, 
            .input-container select {
                width: 100%;
                background: rgba(255, 255, 255, 0.2);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(255, 255, 255, 0.3);
                border-radius: 8px;
                padding: 14px 14px 10px; /* Extra padding at the bottom */
                font-size: 16px;
                color: white;
                transition: all 0.3s ease;
            }
            
            /* ===== ¿ When Input is Focused or Has Text, Move Label Up ===== */
            .input-container input:focus + label,
            .input-container input:not(:placeholder-shown) + label,
            .input-container select:focus + label,
            .input-container select:not([value=""]) + label {
                top: 10px;
                font-size: 12px;
                color: #00f7ff;
            }
            
            /* ===== ¿ Date Picker Styling ===== */
            .ui-datepicker {
                background: rgba(255, 255, 255, 0.9);
                border: 2px solid #009688;
                border-radius: 10px;
                padding: 6px;
            }
            
            .a-Icon.icon-calendar {
                color: white;
            }
            
            /* ===== ¿ Navigation Bar Styling ===== */
            .t-NavigationBar {
                border: 2px solid white;
                background: rgba(0, 0, 0, 0.5);
                box-shadow: 0 -6px 10px -5px #00f7ff, 0 6px 10px -5px #00f7ff;
                border-radius: 20px;
            }
            
            /* ===== ¿ Interactive Report Toolbar ===== */
            .a-IRR-toolbar {
                background: rgba(255, 255, 255, 0.15);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(0, 247, 255, 0.2);
            }
            
            /* ===== ¿ Modal/Dialog Boxes ===== */
            .ui-dialog {
                background: rgba(255, 255, 255, 0.95);
                border-radius: 12px;
                box-shadow: 0 6px 20px rgba(0, 0, 255, 0.3);
            }
            
            /* ===== ¿ Hover Effects ===== */
            .t-Button:hover {
                transform: scale(1.05);
            }
            
            
            .t-Report-report tr:hover td {
                color: #003366 !important; /* Dark Blue */
                transition: color 0.3s ease-in-out;
            }
            
            .a-IRR-table tr:hover td {
                color: #003366 !important; /* Dark Blue */
                transition: color 0.3s ease-in-out;
            }
            
            .t-Report-report tr:hover, .a-IRR-table tr:hover {
                background: rgba(0, 247, 255, 0.1);
                transition: 0.3s ease;
            }
            
            /* ===== ¿ Scrollbar Customization (Modern Look) ===== */
            ::-webkit-scrollbar {
                width: 8px;
            }
            
            ::-webkit-scrollbar-track {
                background: rgba(255, 255, 255, 0.1);
            }
            
            ::-webkit-scrollbar-thumb {
                background: #00f7ff;
                border-radius: 10px;
            }
            
            ::-webkit-scrollbar-thumb:hover {
                background: #009688;
            }
            
            
            /* ===== ¿ Stylish Buttons ===== */
            .t-Button {
                background: linear-gradient(310deg, #0078ff, #00e1ff);
                color: white;
                font-weight: bold;
                border-radius: 6px;
                padding: 10px 14px;
                border: none;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
                transition: all 0.3s ease;
            }
            
            .t-Button:hover {
                transform: scale(1.05);
                background: linear-gradient(310deg, #0050c8, #00a6c7);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #0078ff, #00e1ff);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
                padding: 8px;
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
                padding: 12px 16px;
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                padding: 10px 14px;
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #00bcd4;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            /* ===== ¿ Interactive Effects ===== */
            .t-Button:hover, .t-Report-report tr:hover, .a-IRR-table tr:hover {
                transition: all 0.3s ease;
            }
            
            /* ===== ¿ Dialog Boxes (Popups) ===== */
            .ui-dialog {
                 background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
                border-radius: 12px;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region role-information (
        name: Role Information
        type: form
        source {
            location: localDatabase
            tableName: ROLES_INFO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P29_RI_ID (
        type: hidden
        layout {
            sequence: 10
            region: @role-information
            slot: regionBody
        }
        source {
            formRegion: @role-information
            column: RI_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P29_RI_NAME (
        type: textField
        label {
            label: Role Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @role-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @role-information
            column: RI_NAME
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P29_RI_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_RI_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P29_RI_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 12964332859887753800
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-role-information (
        name: Initialize form Role Information
        type: formInitialization
        formRegion: @role-information
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12964332069846753799
        }
    )

    process process-form-role-information (
        name: Process form Role Information
        type: formAutoRowProcessing
        formRegion: @role-information
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12964332462748753800
        }
    )

)

