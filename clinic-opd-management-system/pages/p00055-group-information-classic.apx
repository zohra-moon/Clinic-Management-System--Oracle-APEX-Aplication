page 55 (
    name: Group information classic
    alias: GROUP-INFORMATION-CLASSIC
    title: Group information classic
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region groups (
        name: "Groups "
        type: classicReport
        source {
            location: localDatabase
            tableName: GROUPS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ACTIVE_FLAG (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 30
            }
        )

        column COMPANY_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Company Id
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column CREATE_BY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Create By
            }
            layout {
                sequence: 50
            }
        )

        column CREATE_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Create Date
            }
            layout {
                sequence: 60
            }
        )

        column GROUP_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Group Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column GROUP_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Group Name
            }
            layout {
                sequence: 20
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Update By
            }
            layout {
                sequence: 70
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Update Date
            }
            layout {
                sequence: 80
            }
        )

    )

    button create (
        buttonName: create
        label: Create
        layout {
            sequence: 20
            region: @groups
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 54
                clearCache: 54
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

