            language: sql
            sqlExpression: :P59_GROUP_MENU_ID is not null and :P59_GROUP_ID is not null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 21266351978404917641
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-group-menu (
        name: Initialize form Group_MENU
        type: formInitialization
        formRegion: @group-menu
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21266351150466917640
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select nvl(max(GROUP_MENU_ID),999)+1
                into :P59_GROUP_MENU_ID
                from Group_Menu;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20685670554826729126
        }
    )

    process process-form-group-menu (
        name: Process form Group_MENU
        type: formAutoRowProcessing
        formRegion: @group-menu
        execution {
            sequence: 20
        }
        advanced {
