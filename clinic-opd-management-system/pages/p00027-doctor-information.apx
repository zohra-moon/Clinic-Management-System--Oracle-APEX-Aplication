    process available-on-save-interactive-grid-data (
        name: Available On - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @available-on
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 12964510135036829001
        }
    )

    process dml-doctor (
        name: dml_doctor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                 v_pk number;
                 V_CHK NUMBER :=0;
                begin
                  select nvl(max(DOC_ID),9999)+1 into v_pk
                  from DOCTORS_INFO;
                
                   ----------------CHECK IF THE RECORD IS EXIST IN DB------------------------------
                    BEGIN
                    SELECT COUNT(*) INTO V_CHK
                    FROM DOCTORS_INFO
                    WHERE doc_id = :P27_DOC_ID;
                    EXCEPTION
                     WHEN OTHERS THEN
                      V_CHK := 0;
                    END;
                
                IF V_CHK = 0 THEN
                insert into DOCTORS_INFO(
                         DOC_ID,
                       DOC_NAME,
                       DOC_DOB,
                      DEPT_ID,
                       MOBILE_NO,
                       EMAIL,
                       NID_NO,
                       REGISTRATION_NO,
                       ADDRESS,
                      
                       INSERT_BY,
                      
                       DIV_NO,
                       DIST_NO,
                       PS_UPAZILA_NO,
                       UNION_NO,
                       DR_SH_ID,
                       DETAILS,
                       DOC_IMAGE
                       )
                 values (
                        v_pk,
                        :P27_NAME,
                        :P27_DOB,
                        :P27_DEPT,
                        :P27_PHONE,
                        :P27_EMAIL,
                        :P27_NID,
                        :P27_REG,
                        :P27_ADDRESS,
                      
                         v('APP_USER'),
                       
                         :P27_DIV,
                         :P27_DIST,
                         :P27_UPAZILA,
                         :P27_UNION,
                         :P27_TIME,
                         :P27_DETAIL,
                         :P27_IMAGE
                
                 );
                ELSIF V_CHK = 1 THEN
                
                 UPDATE DOCTORS_INFO
                  SET  DOC_NAME= :P27_NAME,
                       DOC_DOB= :P27_DOB,
                      DEPT_ID= :P27_DEPT,
                       MOBILE_NO= :P27_PHONE,
                       EMAIL= :P27_EMAIL,
                       NID_NO =:P27_NID,
                       REGISTRATION_NO= :P27_REG,
                       ADDRESS= :P27_ADDRESS,
                       status=:P27_STATUS,
                       DIV_NO= :P27_DIV,
                       DIST_NO = :P27_DIST,
                       PS_UPAZILA_NO= :P27_UPAZILA,
                       UNION_NO=:P27_UNION,
                       DR_SH_ID= :P27_TIME,
                       DETAILS =:P27_DETAIL,
                       UPDATE_BY = v('APP_USER'),
                       UPDATE_DATE = SYSDATE,
                       DOC_IMAGE= :P27_IMAGE
                  WHERE doc_id = :P27_DOC_ID;
                
                END IF;
                commit;
                end;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 12964236361824170676
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

