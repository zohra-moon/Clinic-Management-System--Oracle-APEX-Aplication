    region doctor-services (
        name: Doctor services
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DOC_SERVICE_ID,
                       DOC_ID,
                       SERVICE_ID,
                       RATE,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                       UPDATE_BY,
                       UPDATE_DATE,
                       PATIENT_TYPE,'edit' edit
                  from DOC_SERVICES
                  where doc_id =:P27_DOC_ID
                ```
            pageItemsToSubmit: P27_DOC_ID
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
