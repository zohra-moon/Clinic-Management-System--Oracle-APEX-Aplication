    process new-2 (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    CASE :APEX$ROW_STATUS
                        WHEN 'C' THEN
                            INSERT INTO DOCS_AV_DAY(DOC_DAYS,DOC_ID, SAT,SUN, MON,TUE,WED,THU,FRI)
                            VALUES (DOCTOR_AVL_DAY.NEXTVAL,:p27_DOC_ID, :SAT,:SUN,:MON,:TUE,:WED,:THU,:FRI);
                        WHEN 'U' THEN
                            UPDATE DOCS_AV_DAY
                            SET SAT = :SAT,
                               SUN = :SUN,
                               MON = :MON,
                               TUE = : TUE,
                               WED=:WED,
                               THU = : THU,
                               FRI = : FRI     
                            WHERE DOC_DAYS= :DOC_DAYS;
                    END CASE;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12964654633996114774
        }
        serverSideCondition {
            type: never
        }
    )

