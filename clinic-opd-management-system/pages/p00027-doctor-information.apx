    dynamicAction auto-ref (
        name: auto ref
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @doctor-services
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fetch-value (
        name: fetch value
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                           DOC_NAME,
                           DOC_DOB,
                          DEPT_ID,
                           MOBILE_NO,
                           EMAIL,
                           NID_NO,
                           REGISTRATION_NO,
                           ADDRESS,
                           status,
                           DIV_NO,
                           DIST_NO,
                           PS_UPAZILA_NO,
                           UNION_NO,
                           DR_SH_ID,
                           DETAILS
                           from doctors_info
                           where doc_id =:P27_DOC_ID;
                    ```
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P27_NAME
                    P27_DOB
                    P27_DEPT
                    P27_PHONE
                    P27_EMAIL
                    P27_NID
                    P27_REG
                    P27_ADDRESS
                    P27_STATUS
                    P27_DIV
                    P27_DIST
                    P27_UPAZILA
                    P27_UNION
                    P27_TIME
                    P27_DETAIL
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

