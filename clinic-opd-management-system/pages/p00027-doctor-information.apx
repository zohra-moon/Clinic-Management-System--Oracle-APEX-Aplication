    region available-on (
        name: Available On
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DOC_DAYS,
                       DOC_ID,
                       SAT,
                       SUN,
                       MON,
                       TUE,
                       WED,
                       THU,
                       FRI
                  from DOCS_AV_DAY
                  where doc_id= :P27_DOC_ID;
                ```
            pageItemsToSubmit: P27_DOC_ID_N
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 4025684308514522
        }

