    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @list-of-patients
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @list-of-patients
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P26_P_REG_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @list-of-patients
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_P_REG_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @list-of-patients
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_P_REG_ID
        }
    )

    process gen-pk (
        name: gen_pk
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select nvl(max(p_reg_id),999)+1 into :P26_P_REG_ID
                from patients_reg_info;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12964912856771804556
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process initialize-form-list-of-patients (
        name: Initialize form List of Patients
        type: formInitialization
        formRegion: @list-of-patients
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12964876818166231355
        }
    )

    process process-form-list-of-patients (
        name: Process form List of Patients
        type: formAutoRowProcessing
        formRegion: @list-of-patients
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12964877256450231357
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 25
            }
        }
    )

)

