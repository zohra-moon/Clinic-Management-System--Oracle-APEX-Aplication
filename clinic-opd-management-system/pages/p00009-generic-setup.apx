page 9 (
    name: Generic Setup
    alias: GENERIC-SETUP
    title: Generic Setup
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline:
            ```css
            #bg_one {
                background-color: #EADDCA;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region generic-setup (
        name: Generic Setup
        type: form
        source {
            location: localDatabase
            tableName: GENERIC_INFO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: bg_one
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P9_GENERIC_ID (
        type: hidden
        layout {
            sequence: 10
            region: @generic-setup
            slot: regionBody
        }
        source {
            formRegion: @generic-setup
            column: GENERIC_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P9_GENERIC_NAME (
        type: textarea
        label {
            label: Generic Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @generic-setup
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @generic-setup
            column: GENERIC_NAME
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_INSERT_BY (
        type: hidden
        layout {
            sequence: 50
            region: @generic-setup
            slot: regionBody
        }
        source {
            formRegion: @generic-setup
            column: INSERT_BY
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_INSERT_DATE (
        type: hidden
        layout {
            sequence: 60
            region: @generic-setup
            slot: regionBody
        }
        source {
            formRegion: @generic-setup
            column: INSERT_DATE
            dataType: date
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_NOTE (
        type: textarea
        label {
            label: Note
            alignment: right
        }
        layout {
            sequence: 30
            region: @generic-setup
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @generic-setup
            column: NOTE
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_STATUS (
        type: hidden
        layout {
            sequence: 40
            region: @generic-setup
            slot: regionBody
        }
        source {
            formRegion: @generic-setup
            column: STATUS
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_UPDATE_BY (
        type: hidden
        layout {
            sequence: 70
            region: @generic-setup
            slot: regionBody
        }
        source {
            formRegion: @generic-setup
            column: UPDATE_BY
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_UPDATE_DATE (
        type: hidden
        layout {
            sequence: 80
            region: @generic-setup
            slot: regionBody
        }
        source {
            formRegion: @generic-setup
            column: UPDATE_DATE
            dataType: date
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_GENERIC_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_GENERIC_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_GENERIC_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 12963836614321885157
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process genpk-gen (
        name: genpk gen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select nvl(max(generic_id),999)+1
                into :P9_GENERIC_ID
                 from generic_info;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12964031007603671476
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process initialize-form-generic-setup (
        name: Initialize form Generic Setup
        type: formInitialization
        formRegion: @generic-setup
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12963835802457885157
        }
    )

    process process-form-generic-setup (
        name: Process form Generic Setup
        type: formAutoRowProcessing
        formRegion: @generic-setup
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12963836219593885157
        }
    )

    branch (
        name: Redirect to new
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 8
                items: {
                    P8_GENERIC_ID: &P9_GENERIC_ID.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Redirect to all
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 8
                clearCache: 8
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

