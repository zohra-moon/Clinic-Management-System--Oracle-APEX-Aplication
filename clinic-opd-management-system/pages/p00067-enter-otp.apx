page 67 (
    name: Enter OTP
    alias: ENTER-OTP
    title: Enter OTP
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region enter-otp (
        name: Enter OTP
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: New
        type: staticContent
        source {
            htmlCode:
                ```html
                <!DOCTYPE html>
                <html lang="en">
                <head>
                  <meta charset="UTF-8">
                  <title>OTP Information</title>
                  <style>
                    body {
                      font-family: Arial, sans-serif;
                      background-color: #f6f6f6;
                      margin: 0;
                      padding: 20px;
                    }
                
                    .otp-message {
                      padding: 15px 20px;
                      border-left: 4px solid #0073e6;
                      color: #333;
                    }
                
                    .otp-message p {
                      margin: 0 0 8px;
                      font-size: 14px;
                    }
                
                    .otp-expiry {
                      font-size: 13px;
                      color: #b00020;
                    }
                  </style>
                </head>
                <body>
                
                  <div class="otp-message">
                    <p>An OTP has been sent to your email &P67_EMAIL. .</p>
                    <p class="otp-expiry">OTP will expire in 5 minutes.</p>
                  </div>
                
                </body>
                </html>
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P67_EMAIL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @enter-otp
            slot: regionBody
        }
    )

    pageItem P67_OTP (
        type: textField
        label {
            label: OTP
            alignment: left
        }
        layout {
            sequence: 20
            region: @enter-otp
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button resend-otp (
        buttonName: Resend_OTP
        label: Resend OTP
        layout {
            sequence: 40
            region: @enter-otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--link
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: SUBMIT
        layout {
            sequence: 30
            region: @enter-otp
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction button (
        name: BUTTON
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-apex-items-with-buttons (
            action: plugin/apexItemsWithApexButton
            settings {
                itemWhereTheButtonIsAdded: P67_OTP
            }
            affectedElements {
                selectionType: button
                button: @submit
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-session (
        name: set session
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P67_EMAIL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: APEX_UTIL.SET_SESSION_STATE('P67_EMAIL',:P67_EMAIL);
                itemsToSubmit: P67_EMAIL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: clearSessionState
        clear {
            type: items
            items: P67_OTP
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 128044383817429366523
        }
    )

    process resend-otp (
        name: Resend otp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                l_otp number;
                begin
                l_otp := LPAD(TRUNC(DBMS_RANDOM.VALUE(0,999999)),6,'0');
                
                INSERT INTO app_user_otp(USERNAME, otp_code, expire_at)
                VALUES (:P67_EMAIL, l_otp, SYSDATE + 5/1440);
                
                apex_mail.send(
                 p_to => :P67_EMAIL,
                 p_from => 'noreply@app.com',
                 p_subj => 'Your OTP',
                 p_body => 'OTP: ' || l_otp
                );
                apex_mail.push_queue;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 128044382393215366508
        }
        serverSideCondition {
            whenButtonPressed: @resend-otp
        }
    )

    process verify-otp (
        name: Verify OTP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                l_count number;
                begin
                
                SELECT COUNT(*) INTO l_count
                FROM app_user_otp
                WHERE USERNAME=:P67_EMAIL AND otp_code=:P67_OTP
                 AND expire_at>SYSDATE AND is_used='N';
                
                IF l_count=1 THEN
                 UPDATE app_user_otp SET is_used='Y'
                 WHERE USERNAME=:P67_EMAIL AND otp_code=:P67_OTP;
                ELSE
                 raise_application_error(-20002,'Invalid OTP or expired');
                END IF;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 128044382490703366509
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: RELOAD
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 67
                items: {
                    P67_EMAIL: &P67_EMAIL.
                }
            }
        }
    )

    branch (
        name: 68
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
                items: {
                    P68_EMAIL: &P67_EMAIL.
                }
            }
        }
    )

)

