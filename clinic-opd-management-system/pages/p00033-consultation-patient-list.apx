    region status-card (
        name: Status card
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
    )

    region total (
        name: Total
        title: Total
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  sum(N)  as TOTAL_count ,
                'https://static.vecteezy.com/system/resources/thumbnails/011/976/570/small/hospital-medical-billing-service-with-health-insurance-form-for-hospitalization-or-treatment-on-cartoon-background-illustration-vector.jpg' URL
                 FROM (
                    SELECT COUNT(nurse_st_id) N FROM  DOC_WAITING_LIST
                    UNION ALL
                   SELECT COUNT(nurse_st_id) N FROM  DOC_COMPLETED_LIST
                )
                
                
                
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @status-card
            slot: subRegions
            column: 3
            columnSpan: 3
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            gridColumns: 2
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <DIV align="center">
                     <span style="color: blue; font-weight: bold; font-size: 20px;">TOTAL</span> <br><br>
                     <span style="color: green; font-weight:bold; font-size: 50px;">&TOTAL_COUNT.</span>
                </DIV>
                ```
        }
        media {
            source: urlColumn
            urlColumn: URL
            appearance: widescreen
        }
    )

)

