page 33 (
    name: consultation Patient List
    alias: CONSULTATION-PATIENT-LIST
    title: consultation Patient List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* General Page Styling */
            .t-Body-mainContent {
                background: #FEFBE0;
                color: #004d40;
            }
            
                .t-Body-actions{
                    transition: var(--ut-layout-transition, .1s);
                    width: fit-content;
                }
            
            
            
            
            /* Static Region Styling */
            .t-Region {
                background: #e2ece9;
                border-radius: 10px;
                padding: 14px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Table Styling */
            .t-IRR-table, .a-IG-table {
                background: e2ece9;
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #B6D0E2;
            }
            .t-Report-report td, .a-IRR-table td, .a-IG-table td {
                border: 1px solid #B6D0E2;
                padding: 12px;
                color: #050505;
            }
            
            /* Toolbar Styling */
            .a-IRR-toolbar {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Buttons */
            .t-Button, #save, #btn_submit, #update {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                color: #333;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                transition: 0.3s;
            }
            .t-Button:hover, #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
            }
            #close, #btn_cancel {
                background: linear-gradient(135deg, #FFAAAA, #FF6666);
                color: white;
            }
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(135deg, #FF6666, #CC4444);
            }
            
            /* Input Fields */
            .input-container input, .input-container select {
                width: 100%;
                background: #f6dede;
                border: 1px solid #B6D0E2;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #4A4A4A;
            }
            
            /* Modal/Dialog */
            .ui-dialog {
                background: #FFFFFF;
                border-radius: 10px;
                padding: 16px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 12px rgba(182, 208, 226, 0.5);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
               /* padding: 8px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
               /* padding: 12px 16px;*/
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                /*padding: 10px 14px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #e2ece9;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            
            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-thumb {
                background: #B6D0E2;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #A0B8C8;
            }
            
            /* Hover Effects */
            .t-Report-report tr:hover td, .a-IRR-table tr:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            
            /* Breadcrumb Bar Styling */
            .t-BreadcrumbRegion {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 8px;
                padding: 10px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 2px 6px rgba(182, 208, 226, 0.5);
            }
            .t-BreadcrumbRegion .t-Breadcrumb-label {
                color: #004d40;
                font-weight: bold;
            }
            .t-BreadcrumbRegion a {
                color: #006064;
                text-decoration: none;
                transition: 0.3s;
            }
            .t-BreadcrumbRegion a:hover {
                color: #004d40;
                text-decoration: underline;
            }
            
            .apex-card .t-Card-body {
                display: flex; 
                justify-content: space-between;  /* Moves left & right sections apart */
                align-items: center;  /* Aligns items vertically */
            }
            
            .apex-card .right-side-column {
                text-align: right;  /* Align text to the right */
                font-weight: bold;  /* Make text bold */
                 /* Dark blue color */
                font-size: 14px;
                    background: e2ece9;
            }
            .apex-card .right-side-column:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region completed (
        name: Completed
        title: Completed
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT COUNT(nurse_st_id) as done,
                
                
                
                'https://img.freepik.com/free-vector/doctor-examining-patient-clinic-illustrated_23-2148856559.jpg' url
                 FROM DOC_COMPLETED_LIST
                 WHERE trunc(visit_date) = trunc(sysdate);
                ```
        }
        layout {
            sequence: 30
            parentRegion: @status-card
            slot: subRegions
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            gridColumns: 2
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <DIV align="center">
                     <span style="color: blue; font-weight: bold; font-size: 20px;">COMPLETED</span> <br><br>
                     <span style="color: green; font-weight:bold; font-size: 50px;">&DONE.</span>
                </DIV>
                ```
        }
        media {
            source: urlColumn
            urlColumn: URL
            appearance: widescreen
        }
    )

    region completed-consultation (
        name: Completed Consultation
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CONSULTATION_ID,
                       NURSE_ST_ID,
                       DOC_ID,
                       APP_SERIAL_NO,
                       DOC_NAME,
                       VISIT_DATE,
                       APP_ID APPID,
                       P_NAME,
                       CONSULT_FLAG,
                       PATIENT_TYPE,
                       RATE,
                       OUT_FLAG, 'EMR' EMR
                  from DOC_COMPLETED_LIST
                  ORDER BY 1 DESC
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column APPID (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Appointment ID
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column APP_SERIAL_NO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column CONSULTATION_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Consultation ID
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column CONSULT_FLAG (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

        column DOC_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column DOC_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Doctor Name
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column EMR (
            reportColumnQueryId: 13
            derivedColumn: N
            type: link
            heading {
                heading: EMR
            }
            layout {
                sequence: 150
            }
            link {
                target: {
                    page: 40
                    items: {
                        P40_CONS_ID: #CONSULTATION_ID#
                    }
                }
                linkText: <span class="fa fa-print" aria-hidden="true"></span>
            }
            sorting {
                sortable: false
            }
        )

        column NURSE_ST_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column OUT_FLAG (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column PATIENT_TYPE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Patient Type
                alignment: center
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

        column P_NAME (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Patient Name
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column RATE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Consultation fee
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column VISIT_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Visit Date
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

    )

    region container (
        name: container
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            includeShowAll: false
        }
    )

    region pending (
        name: Pending
        title: Pending
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT COUNT(nurse_st_id) as pending,
                
                
                'https://img.freepik.com/premium-vector/patients-clinic-waiting-room-character-flat-illustration-medicine-healthcare_213110-206.jpg' url
                 FROM DOC_WAITING_LIST
                 WHERE trunc(visit_date) = trunc(sysdate);
                ```
