        componentAppearance {
            gridColumns: 2
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <DIV align="center">
                     <span style="color: blue; font-weight: bold; font-size: 20px;">PENDING</span> <br><br>
                     <span style="color: green; font-weight:bold; font-size: 50px;">&PENDING.</span>
                </DIV>
                ```
        }
        media {
            source: urlColumn
            urlColumn: URL
            appearance: widescreen
        }
    )

