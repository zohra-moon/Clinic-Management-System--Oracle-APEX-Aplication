    process declare-collection (
        name: declare collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF APEX_COLLECTION.COLLECTION_EXISTS ('MEDICINE') THEN
                    APEX_COLLECTION.TRUNCATE_COLLECTION ('MEDICINE');     
                ELSE
                    APEX_COLLECTION.CREATE_COLLECTION ('MEDICINE');  
                END IF;
                
                
                IF APEX_COLLECTION.COLLECTION_EXISTS ('ADVICE') THEN
                    APEX_COLLECTION.TRUNCATE_COLLECTION ('ADVICE');     
                ELSE
                    APEX_COLLECTION.CREATE_COLLECTION ('ADVICE');  
                END IF;
                
                IF APEX_COLLECTION.COLLECTION_EXISTS ('INVESTIGATION') THEN
                    APEX_COLLECTION.TRUNCATE_COLLECTION ('INVESTIGATION');     
                ELSE
                    APEX_COLLECTION.CREATE_COLLECTION ('INVESTIGATION');  
                END IF;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15201480646839365424
        }
    )

    process dml (
        name: dml
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                    V_CONS_NO NUMBER;
                     V_DOC_ID NUMBER;
                      V_P_ID NUMBER;
                     V_N_ST_ID NUMBER;
                    
                    -- Cursor for added medicines
                    CURSOR ADDED_MEDICINE IS 
                        SELECT 
                            SEQ_ID SL,
                            C001 MED_ID,
                            C002 FREQ,
                            C003 TIME,
                            C004 DAYS
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'MEDICINE'
                        ORDER BY SEQ_ID;
                
                    -- Cursor for investigations
                    CURSOR ADDED_INVESTIGATION IS 
                        SELECT 
                            SEQ_ID SL,
                            C001 INV_ID
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'INVESTIGATION'
                        ORDER BY SEQ_ID;
                
                    -- Cursor for advice
                    CURSOR ADDED_ADVICE IS 
                        SELECT 
                            SEQ_ID SL,
                            C001 ADV_ID
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'ADVICE'
                        ORDER BY SEQ_ID;
                
                BEGIN
                    -- Generate the next consultation ID
                    SELECT NVL(MAX(CONSULTATION_ID), 99999) + 1 
                    INTO V_CONS_NO
                    FROM CONSULTATION;
                :G_PRSC := V_CONS_NO;
                    ----get patient, doc and nurse station
                SELECT DOC_ID, P_REG_ID, NURSE_ST_ID
                INTO  V_DOC_ID,   V_P_ID, V_N_ST_ID
                FROM PRE_CONSULT_INFO
                WHERE APP_ID = :P32_APPID;
                
                    -- Insert into CONSULTATION if V_CONS_NO is valid
                    IF V_CONS_NO IS NOT NULL THEN
                        INSERT INTO CONSULTATION (
                            CONSULTATION_ID,
                            FOLLOW_UP_DAYS,
                            NOTE,
                            APP_ID,
                         P_REG_ID,
                          NURSE_ST_ID,
                          DOC_ID,
                            INSERT_BY,
                            INSERT_DATE
                        )
                        VALUES (
                            V_CONS_NO,
                            :P32_FOLLOW_UP_DAYS,-------NEED TO ADD TEXT ITEM
                            :P32_NOTE,
                            :P32_APPID,
                             V_P_ID,
                             V_N_ST_ID,
                            V_DOC_ID,
                            v('APP_USER'),
                            SYSDATE  -- Ensure correct syntax
                        );
                    END IF;
                
                    ----------------- END OF MASTER INSERT --------------------
                
                    -- Loop through added medicines
                    FOR i IN ADDED_MEDICINE LOOP
                        INSERT INTO CONSULT_MEDICINE_DETAILS (
                            MED_DETAIL_ID,
                            CONSULTATION_ID,
                            MED_ID,
                          
                            FREQUENCY,
                            TIME,
                            INTAKE_DAYS,
                            SL_NO
                        ) 
                        VALUES (
                            CONS_MED_DTL_SEQ.NEXTVAL,
                            V_CONS_NO,    -- Assign consultation ID
                            i.MED_ID,    -- Assign medicine ID
                            i.FREQ, -- Ensure this value is properly referenced
                            i.TIME,   -- Ensure frequency value is referenced
                            i.DAYS,
                            i.SL   
                                  -- Sequence number
                        );
                    END LOOP;
                
                    -- Loop through added investigations
                    FOR i IN ADDED_INVESTIGATION LOOP
                        INSERT INTO CONSULT_INV_DETAILS (  -- Correct table name
                            CONSULT_INV_DTL_ID,
                            INV_ID,
                            CONSULTATION_ID,
                            SL_NO
                        ) 
                        VALUES (
                            CONS_INV_DTL_SEQ.NEXTVAL,
                         -- Ensure remarks are referenced
                            i.INV_ID, 
                            V_CONS_NO,
                            i.SL
                        );
                    END LOOP;
                
                    -- Loop through added advice
                    FOR i IN ADDED_ADVICE LOOP
                        INSERT INTO CONS_ADVICE_DETAILS (
                            CONSULT_ADV_DTL_ID,
                            ADV_ID,
                            CONSULTATION_ID,
                            SL_NO
                        ) 
                        VALUES (
                            CONS_MED_DTL_SEQ.NEXTVAL, -- Correct sequence usage
                        -- Ensure remarks are referenced
                            i.ADV_ID, 
                            V_CONS_NO,
                            i.SL
                        );
                    END LOOP;
                
                
                    update NURSE_STATION
                    SET OUT_FLAG='Y'
                    WHERE APP_ID= :P32_APPID;
                
                    -- Commit the transaction
                    COMMIT;
                
                EXCEPTION 
                    WHEN OTHERS THEN 
                        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM); -- Debugging
                        ROLLBACK;
                        RAISE;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15965049551898965701
        }
    )

