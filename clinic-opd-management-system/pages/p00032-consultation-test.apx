                t-Form--slimPadding
            ]
        }
    )

    region more-master-info (
        name: MORE MASTER INFO
        type: staticContent
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
    )

    region patients-info (
        name: patients_info
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    V_CLOB CLOB;
                
                
                BEGIN
                    -- Construct the HTML-formatted content with advanced styling and a specific APP_ID
                    SELECT 
                        '<div style="font-family: Arial, sans-serif;width:250px; font-size: 14px; background-color: #f9f9f9; padding: 15px; border-radius: 10px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);">' ||
                       -- '<b style="color: #003366;">Patient Registration ID:</b> <span style="color: #555;">' || P_REG_ID || '</span><br>' ||
                       '<b><span style= "color: #003366; font-size: 20px;">Patient Information</span></b><br>' ||
                        '<b style="color: #003366;">Patient Name:</b> <span style="color: #555;">' || P_NAME || '</span><br><br>' ||
                        '<b style="color: #003366;">Gender:</b> <span style="color: ' || 
                            CASE 
                                WHEN GENDER = 'F' THEN 'red'
                                ELSE 'blue'
                            END || ';">' || 
                            CASE 
                                WHEN GENDER = 'F' THEN '♀️ Female'
                                ELSE '♂️ Male'
                            END || '</span><br><br>' ||
                        '<b style="color: #003366;">Age:</b> <span style="color: #555;">' || AGE || '</span><br><br>' ||
                        '<b style="color: #003366;">Blood Group:</b> <span style="color: #555;">' || BLOOD_GROUP || '</span><br><br>' ||
                        -- Conditional formatting for Blood Pressure (e.g., high BP in red)
                        '<b style="color: #003366;">Blood Pressure:</b> <span style="color: ' ||
                        CASE 
                            WHEN BP >= '140/90' THEN 'red' 
                            ELSE '#555' 
                        END || ';">' || BP || '</span><br><br>' ||
                        '<b style="color: #003366;">Respiratory Rate:</b> <span style="color: #555;">' || RR || ' Br/min</span><br><br>' ||
                        '<b style="color: #003366;">Heart Rate:</b> <span style="color: #555;">' || H_RATE || ' BPM</span><br><br>' ||
                        '<b style="color: #003366;">Temperature:</b> <span style="color: #555;">' || TEMP || ' °F</span><br><br>' ||
                        '<b style="color: #003366;">Height:</b> <span style="color: #555;">' || HEIGHT || ' CM</span><br><br>' ||
                        '<b style="color: #003366;">Weight:</b> <span style="color: #555;">' || WEIGHT || ' KG</span><br><br>' ||
                        '<b style="color: #003366;">Chief Complaints:</b><br> <span style="color: #555;">' || CHIEF_COMPLAINS || '</span>' ||
                        ' <a href="#" onclick="$(''#prassessment'').dialog(''open''); return false;"><span style="font-size:30px;">✎</span></a><BR></div>'
                    INTO  V_CLOB
                    FROM PRE_CONSULT_INFO
                    WHERE APP_ID=:P32_APPID;
                
                
                
                    -- Output the result as HTML
                RETURN  V_CLOB ;
                END;
                
                ```
            pageItemsToSubmit: P32_APPID
        }
        layout {
            sequence: 60
            slot: rightColumn
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-Form--slimPadding
            ]
        }
    )

    region primary-assessment (
