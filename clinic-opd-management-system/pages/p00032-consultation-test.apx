                    P32_MED_NO_1
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                     V_CHECK NUMBER := 0;
                     V_SEQ_ID NUMBER := 0;
                    BEGIN 
                     
                    BEGIN
                     SELECT COUNT(*),SEQ_ID INTO V_CHECK,V_SEQ_ID
                     FROM APEX_COLLECTIONS
                     WHERE COLLECTION_NAME = 'MEDICINE'
                     AND C001 = :P32_MED_NO_1
                     GROUP BY SEQ_ID;
                    EXCEPTION
                     WHEN OTHERS THEN 
                     NULL;
                    END;
                    
                    
                    
                    IF V_CHECK = 0 THEN
                    
                     APEX_COLLECTION.ADD_MEMBER (P_COLLECTION_NAME      => 'MEDICINE'                                             
                                                ,P_C001                => :P32_MED_NO_1
                                                ,P_C002                => :P32_FREQ
                                                ,P_C003                => :P32_TIME
                                                ,P_C004                => :P32_DAYS
                                               );
                    ELSIF V_CHECK = 1 THEN 
                    
                      APEX_COLLECTION.UPDATE_MEMBER (P_COLLECTION_NAME      => 'MEDICINE'     
                                                    ,P_SEQ                => V_SEQ_ID                                        
                                                ,P_C001                => :P32_MED_NO_1
                                                ,P_C002                => :P32_FREQ
                                                ,P_C003                => :P32_TIME
                                                ,P_C004                => :P32_DAYS
                                               );
                    
                    
                    END IF;
                    
                    
                    END;
                    ```
                itemsToSubmit: [
                    P32_FREQ
                    P32_TIME
                    P32_DAYS
                    P32_MED_NO_1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
