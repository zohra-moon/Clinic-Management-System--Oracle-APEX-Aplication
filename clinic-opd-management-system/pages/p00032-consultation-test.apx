    dynamicAction calculate-bmi (
        name: Calculate BMI
        execution {
            sequence: 90
        }
        when {
            event: keyup
            selectionType: items
            items: [
                P32_HEIGHT
                P32_WEIGHT
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var weight = parseFloat($v("P32_WEIGHT"));
                    var height = parseFloat($v("P32_HEIGHT"))/100;
                    
                    if (weight > 0 && height > 0) {
                        var bmi = weight / (height * height);
                        $s("P32_BMI", bmi.toFixed(2)); // Set the value of P1_BMI
                    }
                    
                    if (bmi < 18.5) category = "Underweight";
                    else if (bmi < 24.9) category = "Normal";
                    else if (bmi < 29.9) category = "Overweight";
                    else category = "Obese";
                    
                    $s("P32_BMI_1", category);
                    ```
            }
            affectedElements {
                selectionType: items
                items: [
                    P32_BMI
                    P32_BMI_1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculate-bmi-2 (
        name: Calculate BMI_1
        execution {
            sequence: 100
        }
        when {
            selectionType: items
