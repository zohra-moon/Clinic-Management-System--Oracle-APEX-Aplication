                           CHIEF_COMPLAINS= :P32_CHIEF_COMPLAINS,
                           UPDATE_BY=  V('APP_USER'),
                           UPDATE_DATE=  SYSDATE
                    WHERE ASSESSMENT_ID= :P32_ASSESSMENT_ID;
                    END IF;
                    ```
                itemsToSubmit: [
