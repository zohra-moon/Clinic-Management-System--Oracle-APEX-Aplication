    dynamicAction dml-pr (
        name: DML_PR
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @submit-2
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @primary-assessment
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P32_ASSESSMENT_ID IS NOT NULL THEN
                    UPDATE PRIMARY_ASSESSMENT
                    SET    BP= :P32_BP,
                           RR= :P32_RR,
                           H_RATE= :P32_H_RATE,
