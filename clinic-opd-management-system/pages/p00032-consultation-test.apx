    dynamicAction add-advice (
        name: ADD ADVICE
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @add-advice
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P32_ADVICE_NAME
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                     V_CHECK NUMBER := 0;
                     V_SEQ_ID NUMBER := 0;
                    BEGIN 
                     
                    BEGIN
                     SELECT COUNT(*),SEQ_ID INTO V_CHECK,V_SEQ_ID
                     FROM APEX_COLLECTIONS
                     WHERE COLLECTION_NAME = 'ADVICE'
                     AND C001 = :P32_ADVICE_NAME
                     GROUP BY SEQ_ID;
                    EXCEPTION
                     WHEN OTHERS THEN 
                     NULL;
                    END;
                    
                    
                    
                    IF V_CHECK = 0 THEN
                    
                     APEX_COLLECTION.ADD_MEMBER (P_COLLECTION_NAME      => 'ADVICE'                                             
                                                ,P_C001                => :P32_ADVICE_NAME
                                             
                                               );
                    ELSIF V_CHECK = 1 THEN 
                    
                      APEX_COLLECTION.UPDATE_MEMBER (P_COLLECTION_NAME      =>'ADVICE'       
                                                    ,P_SEQ                => V_SEQ_ID                                        
                                                ,P_C001                => :P32_ADVICE_NAME
                                              
                                               );
                    
                    
                    END IF;
                    
                    
                    END;
                    ```
                itemsToSubmit: P32_ADVICE_NAME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @added-advice
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction add-to-collection (
        name: ADD TO COLLECTION
        execution {
            sequence: 20
        }
