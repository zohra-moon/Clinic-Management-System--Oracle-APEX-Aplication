page 68 (
    name: Reset Password
    alias: RESET-PASSWORD
    title: Reset Password
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region reset-password (
        name: Reset Password
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P68_CONFIRM_PASS (
        type: password
        label {
            label: Confirm Password
            alignment: left
        }
        settings {
            submitWhenEnterPressed: false
        }
        layout {
            sequence: 30
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P68_EMAIL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @reset-password
            slot: regionBody
        }
    )

    pageItem P68_NEW_PASSWORD (
        type: password
        label {
            label: New Password
            alignment: left
        }
        settings {
            submitWhenEnterPressed: false
        }
        layout {
            sequence: 20
            region: @reset-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit
        layout {
            sequence: 40
            region: @reset-password
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valid-pass (
        name: valid pass
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if :P68_CONFIRM_PASS <> :P68_NEW_PASSWORD or :P68_CONFIRM_PASS is null or :P68_NEW_PASSWORD is null then
                return 'Passwords does not match! ';
                end if;
                ```
            alwaysExecute: true
        }
        error {
            displayLocation: inlineWithField
            associatedItem: @P68_CONFIRM_PASS
        }
    )

    process password-reset (
        name: password reset
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE GUSER
                SET USER_PASS=:P68_CONFIRM_PASS
                WHERE trim(upper(EMAIL))=trim(upper(:P68_EMAIL));
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Password changed successfully!!
        }
        error {
            errorMessage: Password Change failed!!
        }
        advanced {
            executionMappingIdentifier: 128044383282040366517
        }
    )

    branch (
        name: BACK TO LOG IN
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 9999
                clearCache: 68
            }
        }
    )

)

