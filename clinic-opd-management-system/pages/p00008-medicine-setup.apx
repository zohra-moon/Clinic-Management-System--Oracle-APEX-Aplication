page 8 (
    name: Medicine Setup
    alias: MEDICINE-SETUP
    title: Medicine Setup
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* General Page Styling */
            .t-Body-mainContent {
                background: #FEFBE0;
                color: #004d40;
            }
            
            /* Static Region Styling */
            .t-Region {
                background: #e2ece9;
                border-radius: 10px;
                padding: 14px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Table Styling */
            .t-IRR-table, .a-IG-table {
                background: e2ece9;
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #B6D0E2;
            }
            .t-Report-report td, .a-IRR-table td, .a-IG-table td {
                border: 1px solid #B6D0E2;
                padding: 12px;
                color: #000000;
            }
            
            /* Toolbar Styling */
            .a-IRR-toolbar {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Buttons */
            .t-Button, #save, #btn_submit, #update {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                color: #333;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                transition: 0.3s;
            }
            .t-Button:hover, #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
            }
            #close, #btn_cancel {
                background: linear-gradient(135deg, #FFAAAA, #FF6666);
                color: white;
            }
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(135deg, #FF6666, #CC4444);
            }
            
            /* Input Fields */
            .input-container input, .input-container select {
                width: 100%;
                background: #f6dede;
                border: 1px solid #B6D0E2;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #4A4A4A;
            }
            
            /* Modal/Dialog */
            .ui-dialog {
                background: #FFFFFF;
                border-radius: 10px;
                padding: 16px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 12px rgba(182, 208, 226, 0.5);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
               /* padding: 8px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
               /* padding: 12px 16px;*/
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                /*padding: 10px 14px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #e2ece9;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            
            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-thumb {
                background: #B6D0E2;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #A0B8C8;
            }
            
            /* Hover Effects */
            .t-Report-report tr:hover td, .a-IRR-table tr:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            
            /* Breadcrumb Bar Styling */
            .t-BreadcrumbRegion {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 8px;
                padding: 10px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 2px 6px rgba(182, 208, 226, 0.5);
            }
            .t-BreadcrumbRegion .t-Breadcrumb-label {
                color: #004d40;
                font-weight: bold;
            }
            .t-BreadcrumbRegion a {
                color: #006064;
                text-decoration: none;
                transition: 0.3s;
            }
            .t-BreadcrumbRegion a:hover {
                color: #004d40;
                text-decoration: underline;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region generic-setup (
        name: Generic Setup
        type: classicReport
        source {
            location: localDatabase
            tableName: GENERIC_INFO
            whereClause: "GENERIC_ID" = :P8_GENERIC_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: bgtwo
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_GENERIC_ID
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No Record Selected
        }
        componentAdvanced {
            stripHtml: true
        }

        column GENERIC_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "GENERIC_ID" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column GENERIC_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Generic Name
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "GENERIC_NAME" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column INSERT_BY (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "INSERT_BY" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column INSERT_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "INSERT_DATE" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column NOTE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "NOTE" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column STATUS (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "STATUS" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "UPDATE_BY" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 8
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "GENERIC_INFO"
                    where "UPDATE_DATE" is not null
                    and "GENERIC_ID" = :P8_GENERIC_ID
                    ```
            }
        )

    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "GENERIC_ID",
                    null link_class,
                    apex_page.get_url(p_items => 'P8_GENERIC_ID', p_values => "GENERIC_ID") link,
                    null icon_class,
                    null link_attr,
                    null icon_color_class,
                    case when nvl(:P8_GENERIC_ID,'0') = "GENERIC_ID"
                      then 'is-active' 
                      else ' '
                    end list_class,
                    substr("GENERIC_NAME", 1, 50)||( case when length("GENERIC_NAME") > 50 then '...' end ) list_title,
                    null list_text,
                    null list_badge
                from "GENERIC_INFO" x
                where (:P8_SEARCH is null
                        or upper(x."GENERIC_NAME") like '%'||upper(:P8_SEARCH)||'%'
                    )
                order by "GENERIC_NAME"
                ```
            pageItemsToSubmit: P8_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">No Records Found</div>
        }

        column GENERIC_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: GENERIC_ID
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ICON_CLASS
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: ICON_COLOR_CLASS
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: LINK
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: LINK_ATTR
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: LINK_CLASS
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: LIST_BADGE
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: LIST_CLASS
                alignment: center
            }
