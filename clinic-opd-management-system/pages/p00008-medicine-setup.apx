    region medicine-setup (
        name: Medicine Setup
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-medication-pills
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region medicines (
        name: Medicines
        type: classicReport
        source {
            location: localDatabase
            tableName: MEDICINE_INFO
            whereClause: "GENERIC_ID" = :P8_GENERIC_ID
        }
        orderBy {
            type: staticValue
            orderByClause: med_name asc
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noUI
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_GENERIC_ID
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DOSAGE_FORM (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column GENERIC_ID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column INSERT_BY (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 9
            }
        )

        column INSERT_DATE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column MED_DESCRIPTION (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column MED_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: <span class="u-VisuallyHidden">Edit</span>
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 10
                    items: {
                        P10_MED_ID: #MED_ID#
                    }
                    action: resetPagination
                }
                linkText: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 32
            }
        )

        column MED_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Name
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column MED_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Medication Type
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Tablet;Tablet,Nasal Spray;Nasal Spray,Suspension;Suspension,Capsule;Capsule,Syrup;Syrup
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 8
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 11
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 12
            }
        )

        column U_O_M (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

    )

    region no-record-selected (
        name: No Record Selected
        type: staticContent
        source {
            htmlCode: No Record Selected
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P8_GENERIC_ID
        }
    )

    region region-display-selector (
        name: Region Display Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
            cssClasses: js-detail-rds
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_GENERIC_ID
        }
        settings {
            rememberSelection: false
        }
    )

    region search (
        name: Search
        type: staticContent
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: [
                search-region
                padding-md
            ]
        }
    )

    pageItem P8_GENERIC_ID (
        type: hidden
        layout {
            sequence: 40
            region: @generic-setup
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P8_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--postTextBlock
            ]
            icon: fa-search
            width: 30
            valuePlaceholder: Search...
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @medicine-setup
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--hoverIconPush
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                clearCache: 9
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button edit (
        buttonName: EDIT
        label: Edit
        layout {
            sequence: 20
            region: @generic-setup
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                items: {
                    P9_GENERIC_ID: &P8_GENERIC_ID.
                }
                clearCache: 9
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: edit_master_btn
        }
    )

    button pop-medicine-info (
        buttonName: POP_MEDICINE_INFO
        label: Add Medicines
        layout {
            sequence: 10
            region: @medicines
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                items: {
                    P10_GENERIC_ID: &P8_GENERIC_ID.
                }
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @medicine-setup
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
                clearCache: 8
                action: resetPagination
                request: RESET
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-master-record (
        name: Edit Master Record
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @generic-setup
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Generic\u0020Setup\u0020updated');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @generic-setup
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P8_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-on-dialog-close (
        name: Refresh on Dialog Close
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @medicines
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Medicines updated');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @medicines
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

