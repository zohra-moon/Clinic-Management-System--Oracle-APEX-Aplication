page 51 (
    name: "Master details user group "
    alias: USER-GROUP1
    title: user group
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region group-menu (
        name: Group Menu
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       GROUP_ID,
                       GROUP_MENU_ID,
                       (select MENU_NAME from MENU
                       where MENU_CODE = c.MENU_CODE)
                       MENU_CODE,
                       MENU_NAME,
                       APEX_PAGE_NO,
                       IS_STATUS,
                       IS_SELECT,
                       IS_UPDATE,
                       IS_DELETE,
                       COMPANY_ID,
                       CREATE_BY,
                       CREATE_DATE,
                       UPDATE_BY,
                       UPDATE_DATE
                  from GROUP_MENU c
                 where "GROUP_ID" = :P51_USER_GROUP_ID
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_USER_GROUP_ID
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column APEX_PAGE_NO (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

        column COMPANY_ID (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 11
            }
        )

        column CREATE_BY (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 12
            }
        )

        column CREATE_DATE (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 13
            }
        )

        column GROUP_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column GROUP_MENU_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Group Menu Id
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column IS_DELETE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column IS_SELECT (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 8
            }
        )

        column IS_STATUS (
            reportColumnQueryId: 7
            derivedColumn: N
