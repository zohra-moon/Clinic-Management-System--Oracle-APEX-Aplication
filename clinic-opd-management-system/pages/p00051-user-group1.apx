    region user-group-2 (
        name: User Group
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select USER_GROUP_ID,
                (select USER_NAME from guser
                where user_id = c.user_id)
                       USER_ID,
                       (select GROUP_NAME from GROUPS
                       where group_id = c.group_id)
                       GROUP_ID,
                       ACTIVE_FLAG,
                       COMPANY_ID,
                       CREATE_BY,
                       CREATE_DATE,
                       UPDATE_BY,
                       UPDATE_DATE
                  from USER_GROUP c 
                 where "USER_GROUP_ID" = :P51_USER_GROUP_ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_USER_GROUP_ID
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No Record Selected
        }
        componentAdvanced {
            stripHtml: true
        }

        column ACTIVE_FLAG (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "USER_GROUP"
                    where "ACTIVE_FLAG" is not null
                    and "USER_GROUP_ID" = :P51_USER_GROUP_ID
                    ```
            }
        )

