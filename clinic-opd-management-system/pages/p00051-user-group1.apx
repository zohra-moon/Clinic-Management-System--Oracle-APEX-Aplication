            layout {
                sequence: 7
            }
        )

        column IS_UPDATE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 9
            }
        )

        column MENU_CODE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Menu Code
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column MENU_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: <span class="u-VisuallyHidden">Edit</span>
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 53
                    items: {
                        P53_ROWID: #ROWID#
                    }
                    action: resetPagination
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 32
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 14
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 15
            }
        )

    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "USER_GROUP_ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P51_USER_GROUP_ID', p_values => "USER_GROUP_ID") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P51_USER_GROUP_ID,'0') = "USER_GROUP_ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("USER_ID", 1, 50)||( case when length("USER_ID") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("ACTIVE_FLAG", 1, 50)||( case when length("ACTIVE_FLAG") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "USER_GROUP" x
                where (:P51_SEARCH is null
                        or upper(x."USER_ID") like '%'||upper(:P51_SEARCH)||'%'
                        or upper(x."ACTIVE_FLAG") like '%'||upper(:P51_SEARCH)||'%'
                    )
                order by "USER_ID"
                ```
            pageItemsToSubmit: P51_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">No data found.</div>
        }

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ICON_CLASS
