page 54 (
    name: Group information
    alias: GROUP-INFORMATION
    title: Group information
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region group-information (
        name: Group information
        type: form
        source {
            location: localDatabase
            tableName: GROUPS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P54_ACTIVE_FLAG (
        type: textField
        label {
            label: Active Flag
            alignment: right
        }
        layout {
            sequence: 30
            region: @group-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 1
        }
        source {
            formRegion: @group-information
            column: ACTIVE_FLAG
            dataType: varchar2
        }
    )

    pageItem P54_COMPANY_ID (
        type: hidden
        layout {
            sequence: 40
            region: @group-information
            slot: regionBody
        }
        source {
            formRegion: @group-information
            column: COMPANY_ID
            dataType: number
        }
    )

    pageItem P54_CREATE_BY (
        type: hidden
        layout {
            sequence: 50
            region: @group-information
            slot: regionBody
        }
        source {
            formRegion: @group-information
            column: CREATE_BY
            dataType: varchar2
        }
    )

    pageItem P54_CREATE_DATE (
        type: hidden
        layout {
            sequence: 60
            region: @group-information
            slot: regionBody
        }
        source {
            formRegion: @group-information
            column: CREATE_DATE
            dataType: date
        }
    )

    pageItem P54_GROUP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @group-information
            slot: regionBody
        }
        source {
            formRegion: @group-information
            column: GROUP_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P54_GROUP_NAME (
        type: textField
        label {
            label: Group Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @group-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @group-information
            column: GROUP_NAME
            dataType: varchar2
        }
    )

    pageItem P54_UPDATE_BY (
        type: hidden
        layout {
            sequence: 70
            region: @group-information
            slot: regionBody
        }
        source {
            formRegion: @group-information
            column: UPDATE_BY
            dataType: varchar2
        }
    )

    pageItem P54_UPDATE_DATE (
        type: hidden
        layout {
            sequence: 80
            region: @group-information
            slot: regionBody
        }
        source {
            formRegion: @group-information
            column: UPDATE_DATE
            dataType: date
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @group-information
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @group-information
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P54_GROUP_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @group-information
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P54_GROUP_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @group-information
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P54_GROUP_ID
        }
    )

    process initialize-form-group-information (
        name: Initialize form Group information
        type: formInitialization
        formRegion: @group-information
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21273682331185157110
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select nvl(max(GROUP_ID ),999)+1
                into :P54_GROUP_ID
                from GROUPS
                order by 1 desc;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20685670759298729128
        }
    )

    process process-form-group-information (
        name: Process form Group information
        type: formAutoRowProcessing
        formRegion: @group-information
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 21273682728729157111
        }
    )

    branch (
        name: Go To Page 55
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 55
            }
        }
    )

)

