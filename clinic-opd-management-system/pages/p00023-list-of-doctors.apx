page 23 (
    name: List of Doctors
    alias: LIST-OF-DOCTORS
    title: List of Doctors
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* General Page Styling */
            .t-Body-mainContent {
                background: #FEFBE0;
                color: #004d40;
            }
            
            /* Static Region Styling */
            .t-Region {
                background: #e2ece9;
                border-radius: 10px;
                padding: 14px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Table Styling */
            .t-IRR-table, .a-IG-table {
                background: e2ece9;
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #B6D0E2;
            }
            .t-Report-report td, .a-IRR-table td, .a-IG-table td {
                border: 1px solid #B6D0E2;
                padding: 12px;
                color: #010101;
            }
            
            /* Toolbar Styling */
            .a-IRR-toolbar {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Buttons */
            .t-Button, #save, #btn_submit, #update {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                color: #333;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                transition: 0.3s;
            }
            .t-Button:hover, #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
            }
            #close, #btn_cancel {
                background: linear-gradient(135deg, #FFAAAA, #FF6666);
                color: white;
            }
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(135deg, #FF6666, #CC4444);
            }
            
            /* Input Fields */
            .input-container input, .input-container select {
                width: 100%;
                background: #f6dede;
                border: 1px solid #B6D0E2;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #4A4A4A;
            }
            
            /* Modal/Dialog */
            .ui-dialog {
                background: #FFFFFF;
                border-radius: 10px;
                padding: 16px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 12px rgba(182, 208, 226, 0.5);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
               /* padding: 8px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
               /* padding: 12px 16px;*/
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                /*padding: 10px 14px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #e2ece9;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            
            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-thumb {
                background: #B6D0E2;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #A0B8C8;
            }
            
            /* Hover Effects */
            .t-Report-report tr:hover td, .a-IRR-table tr:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            
            /* Breadcrumb Bar Styling */
            .t-BreadcrumbRegion {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 8px;
                padding: 10px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 2px 6px rgba(182, 208, 226, 0.5);
            }
            .t-BreadcrumbRegion .t-Breadcrumb-label {
                color: #000000;
                font-weight: bold;
            }
            .t-BreadcrumbRegion a {
                color: #006064;
                text-decoration: none;
                transition: 0.3s;
            }
            .t-BreadcrumbRegion a:hover {
                color: #004d40;
                text-decoration: underline;
            }
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region list-of-doctor (
        name: List of Doctor
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
            icon: fa-user-md
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region list-of-doctors (
        name: List of Doctors
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DOC_ID,
                       DOC_NAME,
                       DOC_DOB,
                       DEPT_ID,
                       ( select l.DEPT_NAME from DEPARTMENTS_INFO l where l.DEPT_ID = m.DEPT_ID) DEPT_ID_L$1,
                       MOBILE_NO,
                       EMAIL,
                       NID_NO,
                       JOIN_DATE,
                       REGISTRATION_NO,
                       RESIGN_DATE,
                       ADDRESS,
                       SPECIALIZATION,
                       sys.dbms_lob.getlength(DOC_IMAGE) DOC_IMAGE,
                       STATUS,
                       DIV_NO,
                       DIST_NO,
                       PS_UPAZILA_NO,
                       UNION_NO,
                       DR_SH_ID, 'edit' edit
                from DOCTORS_INFO m
                order by doc_id asc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ADDRESS (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

        column DEPT_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column DEPT_ID_L$1 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Department
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column DIST_NO (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column DIV_NO (
            reportColumnQueryId: 16
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column DOC_DOB (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column DOC_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column DOC_IMAGE (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column DOC_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Doc Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column DR_SH_ID (
            reportColumnQueryId: 20
            derivedColumn: N
            type: hidden
            layout {
                sequence: 200
            }
        )

        column EDIT (
            reportColumnQueryId: 21
            derivedColumn: N
            type: link
            heading {
                heading: Edit
                alignment: center
            }
            layout {
                sequence: 210
            }
            link {
                target: {
                    page: 27
                    items: {
                        P27_DOC_ID: #DOC_ID#
                    }
                }
                linkText: <span class="fa fa-edit" aria-hidden="true"></span>
            }
            sorting {
                sortable: false
            }
        )

        column EMAIL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Email
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column JOIN_DATE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column MOBILE_NO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Mobile No
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column NID_NO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column PS_UPAZILA_NO (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hidden
            layout {
                sequence: 180
            }
        )

        column REGISTRATION_NO (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 100
            }
        )

        column RESIGN_DATE (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

        column SPECIALIZATION (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column STATUS (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column UNION_NO (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

    )

    button add-new (
        buttonName: Add_new
        label: Add New
        layout {
            sequence: 10
            region: @list-of-doctor
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--hoverIconPush
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

