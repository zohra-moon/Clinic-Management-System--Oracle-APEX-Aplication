    javaScript {
        fileUrls: https://cdn.jsdelivr.net/npm/sweetalert2@11.4.0/dist/sweetalert2.all.min.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function GetValues() {
                ckbox = document.getElementsByName("f10");
                count = 0;
                for (var i = 0; i < ckbox.length; i++) {
                    element = ckbox[i];
                    if (element.checked) {
                        count++;
                    }
                }
                if (count == 0) {
                    //document.getElementById("P60_COUNT").value = 0;
                    $s('P60_COUNT','0');
                    //document.getElementById("btn_selectedVal").innerHTML = "<b>" + 0 + "</b>";
                } else {
                    //document.getElementById("P60_COUNT").value = count;
                     $s('P60_COUNT',count);
                    //document.getElementById("btn_selectedVal").innerHTML = "<b>" + "You Selected: " + count + " List" + "</b>";
                }
            }
            
            ```
    }
    css {
        fileUrls: https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.12.1/css/all.min.css
        inline:
            ```css
            /* General Page Styling */
            .t-Body-mainContent {
                background: #FEFBE0;
                color: #004d40;
            }
            
            /* Static Region Styling */
            .t-Region {
                background: #e2ece9;
                border-radius: 10px;
                padding: 14px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Table Styling */
            .t-IRR-table, .a-IG-table {
                background: e2ece9;
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #B6D0E2;
            }
            .t-Report-report td, .a-IRR-table td, .a-IG-table td {
                border: 1px solid #B6D0E2;
                padding: 12px;
                color: #060606;
            }
            
            /* Toolbar Styling */
            .a-IRR-toolbar {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Buttons */
            .t-Button, #save, #btn_submit, #update {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                color: #333;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                transition: 0.3s;
            }
            .t-Button:hover, #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
            }
            #close, #btn_cancel {
                background: linear-gradient(135deg, #FFAAAA, #FF6666);
                color: white;
            }
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(135deg, #FF6666, #CC4444);
            }
            
            /* Input Fields */
            .input-container input, .input-container select {
                width: 100%;
                background: #f6dede;
                border: 1px solid #B6D0E2;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #4A4A4A;
            }
            
            /* Modal/Dialog */
            .ui-dialog {
                background: #FFFFFF;
                border-radius: 10px;
                padding: 16px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 12px rgba(182, 208, 226, 0.5);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
               /* padding: 8px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
               /* padding: 12px 16px;*/
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                /*padding: 10px 14px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #e2ece9;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            
            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-thumb {
                background: #B6D0E2;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #A0B8C8;
            }
            
            /* Hover Effects */
            .t-Report-report tr:hover td, .a-IRR-table tr:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            
            /* Breadcrumb Bar Styling */
            .t-BreadcrumbRegion {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 8px;
                padding: 10px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 2px 6px rgba(182, 208, 226, 0.5);
            }
            .t-BreadcrumbRegion .t-Breadcrumb-label {
                color: #004d40;
                font-weight: bold;
            }
            .t-BreadcrumbRegion a {
                color: #006064;
                text-decoration: none;
                transition: 0.3s;
            }
            .t-BreadcrumbRegion a:hover {
                color: #004d40;
                text-decoration: underline;
            }
            
            .status-badge {
                display: inline-block;
                padding: 5px 10px;
                border-radius: 5px;
                cursor: pointer;
                font-weight: bold;
                text-align: center;
                min-width: 100px;
            }
            
            /* Existing styles */
            .Processing {
                  background: linear-gradient(#FEFBE0, #9ac5e4);
                color: rgb(234, 98, 7);
                font-weight: bold;
            }
            .Completed {
                 background: linear-gradient(#FEFBE0, #9ac5e4);
                 color: #013d33;
                font-weight: bold;
            }
            
            /* New "Not Done" status */
            .Not-Done {
               background: linear-gradient(#FEFBE0, #9ac5e4);
                color: rgb(180, 3, 3);
                font-weight: bold;
            }
            
            
            .Paid {
                 background: linear-gradient(#FEFBE0, #9ac5e4);
                 color: #013d33;
                font-weight: bold;
            }
            
            .Due {
                   background: linear-gradient(#FEFBE0, #9ac5e4);
                 color: #a30c0c;
                font-weight: bold;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emr (
        name: EMR
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                DECLARE
                V_CLOB CLOB DEFAULT '';
                 
                 CURSOR PRE_CON IS
                 select c.consultation_id,'C'||c.consultation_id, c.doc_id,c.follow_UP_DAYS,v.visit_date,'PR'||v.p_reg_id, v.p_name, V.DETAILS, V.DEPT_NAME, V.DOC_NAME,
                CASE WHEN v.Gender ='F' THEN 'Female'
                    When v.Gender ='M' THEN 'Male'
                    else 'Other' end as Gender
                , v.age,v.blood_group,
                v.bp, v.rr,v.h_rate,v.temp,v.Height,v.Weight, v.chief_complains
                from consultation c join pre_consult_info v
                on(c.app_id = v.app_id)
                where c.consultation_id=to_number(:P60_CONS_ID);
                VREC PRE_CON%ROWTYPE;
                
                CURSOR CLINIC_INFO IS
                select clinic_name, address, 'Hotline: '||PHONE_NO||', E-mail: '||email||', Web: '||website as contact
                from clinic_info;
                 CREC CLINIC_INFO%ROWTYPE;
                
                    CURSOR EMR_INFO IS
                    SELECT CONSULTATION_ID, FOLLOW_UP_DAYS,NOTE,INSERT_BY, INSERT_DATE
                    FROM CONSULTATION
                    WHERE CONSULTATION_ID= :P60_CONS_ID;
                    EREC EMR_INFO%ROWTYPE;
                
                    CURSOR INV_DTL IS 
                    SELECT 
                           SL_NO, EMR_PKG.GET_INV(INV_ID) INV_NAME
                    FROM CONSULT_INV_DETAILS
                    WHERE CONSULTATION_ID = :P60_CONS_ID
                    ORDER BY SL_NO;
                    
                
                    CURSOR ADV_DTL IS
                    SELECT  SL_NO, EMR_PKG.GET_ADV(ADV_ID) ADV_NAME
                    FROM CONS_ADVICE_DETAILS
                    WHERE CONSULTATION_ID = :P60_CONS_ID
                    ORDER BY SL_NO;
                    AREC ADV_DTL%ROWTYPE;
                
                
                    CURSOR MED_DTL IS
                    SELECT 
                       SL_NO,EMR_PKG.GET_MED(MED_ID) MED_NAME, FREQUENCY,TIME,INTAKE_DAYS
                    FROM CONSULT_MEDICINE_DETAILS
                    WHERE CONSULTATION_ID = :P60_CONS_ID
                    ORDER BY SL_NO;
                    MREC MED_DTL%ROWTYPE;
                
                
                BEGIN
                 OPEN PRE_CON;
                    FETCH PRE_CON INTO VREC;
                    V_CLOB := ('
                    <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Document</title>
                    <style>
                        @media print {
                            size: A4;
                            margin: 2cm;
                        }
                        .doctor-details h3 {
                            margin:0;
                            text-align: left;
                        }
                        .doctor-details h4 {
                            margin:0;
                        }
                        .body {
                            font-family:Arial;
                        }
                        hr {
                            box-sizing: content-box;
                            height: 2px;
                            border: 0;
                            overflow: visible;
                            background: gray;
                        }
                        table tr td .rx-section {
                            min-height: 200px;
                        }
                        table tr td,th {
                            padding : 10px;
                        }
                    </style>
                </head>
                <body>
                ');
                V_CLOB :=  ('
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse; width:100%">
                        <thead>
                            <tr>
                                <td width =60% colspan="4">
                                    <div class="doctor-details" align= left>
                                        <h4 style="color:#27567c;">
                                           '||VREC.DOC_NAME||'
                                        </h4>
                                        <h5 style="color: rgb(184, 78, 78); font-weight: bolder;">'||VREC.DETAILS||'</h5>
                                    </div>
                                </td>
                        
                                  
                            </tr>
                        </thead>
                    </table><hr>');
                    V_CLOB := V_CLOB || ('
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse; width:100%">
                        <tr style="border-bottom: 1px solid black;">
                            <td colspan="2" >
                                <div style="display: flex; justify-content: space-between;">
                                    <span><b>Patient Name: </b>'||VREC.P_NAME||' </span>
                                    <span><b>Age: </b>'||VREC.AGE||'</span>
                                    <span><b>Gender: </b>'||VREC.GENDER||'   </span>
                                    <span><b>Date: </b>'||VREC.VISIT_DATE||' </span>
                                </div>
                            </td>
                        </tr>
                        </table>'
                    );
                
                  V_CLOB:= V_CLOB||'
                   <table width=100% border=0 style="border-collapse: collapse;">
                        <TR> 
                               <td width="30%" style=" padding:15px; border-right: 1px solid black; vertical-align: top;" rowspan=2 >
                  
                                     <div> <STRONG style="font-size:16px;  padding-top: 20px;">Chief Complain</strong><br>
                
                                        <span  style="padding-left: 15px;">'||vrec.chief_complains||'</span><br><br>
                
                                      <STRONG style="font-size:16px;">Clinical Findings</strong><br>
                
                                         <b  style="padding-left: 15px;">  Blood Group:</b> '||vrec.blood_group||'<br>
                                         <b style="padding-left: 15px;">  Weight:</b> '||vrec.weight||'<br>
                                          <b style="padding-left: 15px;">  Height:</b> '||vrec.height||'<br>
                                           <b style="padding-left: 15px;">  Resp. Rate:</b> '||vrec.rr||'<br>
                                            <b style="padding-left: 15px;">  Heart Rate:</b> '||vrec.h_rate||'<br>
                                             <b style="padding-left: 15px;">  Blood Pressure:</b> '||vrec.bp||'<br>
                                              <b style="padding-left: 15px;">  Temperature:</b> '||vrec.temp||'<br>
                                        ';
                                      
                                      v_clob:= v_clob||'<br>
                                     </div>
                  
                  
                  
                  
                  
                                  <div> <STRONG style="font-size:16px;">Investigations</strong><br>
                                  <ul>';
                                  for inv in INV_DTL loop
                                  V_CLOB:= V_CLOB||
                                     '<li>'||inv.inv_name||'</li>';
                                  end loop;
                                  
                                  v_clob:= v_clob||'</ul><br>
                                  </div>
                                  
                                  <div>
                                  <STRONG style="font-size:16px;">Advice</strong><br>';
                                  for adv in ADV_DTL loop
                                    V_CLOB:= V_CLOB||
                                  ' <span  style="padding-left: 15px;">'||ADV.sl_no||'. '||ADV.ADV_name||'</span><br>';
                                  end loop;
                                  
                                  v_clob:= v_clob||'<br>
                                  </div>
                                  
                  
                            </td>
                            <td width="70%" style="vertical-align: top; padding:30px;">
                                 <div> <STRONG style="font-size:22px;">R<sub>x</sub></strong><br>';
                                  for MED in MED_DTL looP
                                    V_CLOB:= V_CLOB||
                                '<span  style="padding-left: 15px;">'||  MED.sl_no||'. '||MED.MED_name||'-'||MED.FREQUENCY||'('||MED.TIME||')- For '||med.intakE_days||' days</span><br><br>';
                                  end loop;
                                  
                                  v_clob:= v_clob||'<br>
                                  </div>
                                  <div><STRONG style="font-size:16px;">Follow Up</strong><br>
                                  <p> after '||VREC.follow_UP_DAYS||'</p>
                            </td>
                          </tr>
                          <tr>
                               <td align= right>
                                  <div>
                                                       
                                    <hr align=right style="width: 150px;">
                                     '||VREC.DOC_NAME||'
                
                
                                  </div>
                            </td>
                        </tr>
                
                
                      
                    </table>
                </body>
                </html>
                    ';
                
                
                    RETURN (V_CLOB);
                END;
                ```
            pageItemsToSubmit: P60_CONS_ID
        }
        layout {
            sequence: 40
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size720x480
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region nurse-station (
        name: Nurse Station
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select NURSE_ST_ID,
                       VISIT_DATE,
                       IN_FLAG,
                       APEX_ITEM.CHECKBOX (P_IDX         => 11,
                                                      P_VALUE        =>  NURSE_ST_ID,
                                                      P_ATTRIBUTES   =>  DECODE(CONSULT_FLAG,'Y','CHECKED',NULL)--'class="emp_check1" ',
                                                     
                                                   ) AS CONSULT_FLAG1,
                
                APEX_ITEM.CHECKBOX (P_IDX         => 12,      
                                                      P_VALUE        =>  NURSE_ST_ID,
                                                      P_ATTRIBUTES   =>  DECODE(IN_FLAG,'1','CHECKED',NULL)--'class="emp_check1" ',
                                                     
                                                   ) AS IN_FLAG1,
                     APEX_ITEM.CHECKBOX (P_IDX         => 13,      
                                                      P_VALUE        =>  NURSE_ST_ID,
                                                      P_ATTRIBUTES   =>  DECODE(BILLING_FLAG,'P','CHECKED',NULL)--'class="emp_check1" ',
                                                     
                                                   ) AS billing_flag1,
                         APEX_ITEM.CHECKBOX (P_IDX         => 14,      
                                                      P_VALUE        =>  NURSE_ST_ID,
                                                      P_ATTRIBUTES   =>  DECODE(OUT_FLAG,'Y','CHECKED',NULL)--'class="emp_check1" ',
                                                     
                                                   ) AS OUT_flag1,
                
                        APEX_ITEM.CHECKBOX (P_IDX         => 10,      
                                                      P_VALUE        =>  NURSE_ST_ID,
                                                      P_ATTRIBUTES   =>  'class="emp_check1" onchange ="getvalues();"',
                                                     P_CHECKED_VALUES => :P60_COUNT
                                                     
                                                   ) AS CK_BOX_HALIMA,
                       CONSULT_FLAG,
                       BILLING_FLAG,
                       CASE WHEN NVL(BILLING_FLAG,'N')='P' THEN 'Paid'
                       else 'Due'
                       end as Bill_status,
                       OUT_FLAG,
                       APP_ID APPID,
                         APP_ID Patient_name,
                          APP_ID doctor_name,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                       UPDATE_BY,
                       UPDATE_DATE,
                       STATUS_VITAL_SIGN,
                       'VITAL' VITAL, 'PRINT' PRINT
                
                  from NURSE_STATION
                 
                  ORDER BY 1 DESC;
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: emp_dtl
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

