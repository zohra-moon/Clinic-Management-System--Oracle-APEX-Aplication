        column STATUS_VITAL_SIGN (
            reportColumnQueryId: 21
            derivedColumn: N
            heading {
                heading: Status Vital Sign
                alignment: center
            }
            layout {
                sequence: 190
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="status-badge #STATUS_VITAL_SIGN#" data-id="#NURSE_ST_ID#">#STATUS_VITAL_SIGN#</span>
                    
                    ```
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 20
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column VISIT_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Visit Date
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column VITAL (
            reportColumnQueryId: 22
            derivedColumn: N
            type: link
            layout {
                sequence: 200
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript:$s('P36_NURSE_ST_ID','#NURSE_ST_ID#');
                }
                linkText: <span class="fa fa-user-check" aria-hidden="true"></span>
            }
            sorting {
                sortable: false
            }
        )

    )

