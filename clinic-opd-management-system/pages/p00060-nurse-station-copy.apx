    dynamicAction chng-vital-status (
        name: CHNG VITAL STATUS_1
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .Completed
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    UPDATE NURSE_STATION
                    SET STATUS_VITAL_SIGN = 'Processing'
                    WHERE NURSE_ST_ID = :P60_N_ST_ID;
                    
                    ```
                itemsToSubmit: P60_N_ST_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @primary-assessment
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nurse-station
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    
                    select ASSESSMENT_ID,
                           PULSE,
                           BP,
                           RR,
                           H_RATE,
                           TEMP,
                           HEIGHT,
                           WEIGHT,
                           CHIEF_COMPLAINS,
                           NOTE
                    
                    from PRIMARY_ASSESSMENT
                    WHERE NURSE_ST_ID= :P60_N_ST_ID
                    
                    ```
                itemsToSubmit: P60_N_ST_ID
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P60_ASSESSMENT_ID
                    P60_PULSE
                    P60_BP
                    P60_RR
                    P60_H_RATE
                    P60_TEMP
                    P60_HEIGHT
                    P60_WEIGHT
                    P60_CHIEF_COMPLAINS
                    P60_NOTE
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

