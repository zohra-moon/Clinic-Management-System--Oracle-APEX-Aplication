    dynamicAction dml-primary-assessment (
        name: dml primary assessment
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @submit-pr-as
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P60_ASSESSMENT_ID
                    P60_PULSE
                    P60_BP
                    P60_RR
                    P60_H_RATE
                    P60_TEMP
                    P60_HEIGHT
                    P60_WEIGHT
                    P60_CHIEF_COMPLAINS
                    P60_NOTE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @primary-assessment
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P60_ASSESSMENT_ID IS NULL THEN
                    INSERT INTO PRIMARY_ASSESSMENT
                    (
                           ASSESSMENT_ID,
                           PULSE,
                           BP,
                           RR,
                           H_RATE,
                           TEMP,
                           HEIGHT,
                           WEIGHT,
                           CHIEF_COMPLAINS,
                           NOTE,
                           NURSE_ST_ID,
                           STATUS,
                           INSERT_BY,
                           INSERT_DATE
                    
                    )
                    VALUES(
                        ASSESS_PK_SEQ.NEXTVAL,
                        :P60_PULSE,
                        :P60_BP,
                        :P60_RR,
                        :P60_H_RATE,
                        :P60_TEMP,
                        :P60_HEIGHT,
                        :P60_WEIGHT,
                        :P60_CHIEF_COMPLAINS,
                        :P60_NOTE,
                        :P60_NURSE_ST_ID,
                        'Y',
                        V('APP_USER'),
                        SYSDATE
                    );
                    
                    else
                    UPDATE PRIMARY_ASSESSMENT
                    SET   PULSE = :P60_PULSE,
                           BP= :P60_BP,
                           RR= :P60_RR,
                           H_RATE= :P60_H_RATE,
                           TEMP= :P60_TEMP,
                           HEIGHT=:P60_HEIGHT,
                           WEIGHT=:P60_WEIGHT,
                           CHIEF_COMPLAINS= :P60_CHIEF_COMPLAINS,
                           NOTE= :P60_NOTE,
                           UPDATE_BY=  V('APP_USER'),
                           UPDATE_DATE=  SYSDATE
                    WHERE NURSE_ST_ID= :P60_NURSE_ST_ID;
                    
                    
                    END IF;
                    
                    
                    
                    
                    
                    UPDATE NURSE_STATION
                    SET STATUS_VITAL_SIGN= 'Completed'
                    where NURSE_ST_ID= :P60_NURSE_ST_ID;
                    ```
                itemsToSubmit: [
                    P60_ASSESSMENT_ID
                    P60_PULSE
                    P60_BP
                    P60_RR
                    P60_H_RATE
                    P60_TEMP
                    P60_HEIGHT
                    P60_WEIGHT
                    P60_CHIEF_COMPLAINS
                    P60_NOTE
                    P60_NURSE_ST_ID
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nurse-station
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

