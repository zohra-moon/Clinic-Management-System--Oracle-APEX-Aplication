    process dml-on-chkbox (
        name: dml on chkbox
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                For i in 1..APEX_APPLICATION.G_F11.COUNT LOOP
                 UPDATE NURSE_STATION 
                 SET CONSULT_FLAG = 'Y'
                 WHERE NURSE_ST_ID = TO_NUMBER(APEX_APPLICATION.G_F11(i));
                END LOOP;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 22746646094812190645
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                   IF APEX_APPLICATION.G_F10.COUNT <> 0 THEN
                      FOR I IN 1 .. APEX_APPLICATION.G_F10.COUNT LOOP
                         UPDATE NURSE_STATION
                         SET CONSULT_FLAG = 'Y'
                         WHERE NURSE_ST_ID = APEX_APPLICATION.G_F10(I);
                      END LOOP;
                   END IF;
                END;
                
                
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 20298361574652635011
        }
    )

)

