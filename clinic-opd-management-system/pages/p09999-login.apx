    dynamicAction set-username-session (
        name: set username session
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P9999_USERNAME
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: APEX_UTIL.SET_SESSION_STATE('P9999_USERNAME',:P9999_USERNAME);
                itemsToSubmit: P9999_USERNAME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valid-user (
        name: valid user
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_dummy NUMBER;
                BEGIN
                    IF :P9999_USERNAME IS NULL THEN
                        RETURN 'Username is required';
                    END IF;
                
                    BEGIN
                        SELECT 1
                        INTO l_dummy
                        FROM GUSER
                        WHERE TRIM(UPPER(user_name)) = TRIM(UPPER(:P9999_USERNAME));
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN 'User not found';
                    END;
                
                    RETURN NULL;
                END;
                ```
            alwaysExecute: true
        }
        error {
            associatedItem: @P9999_USERNAME
        }
        serverSideCondition {
            whenButtonPressed: @bt-forgot
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 12963307302142155611
        }
    )

    process cust-login (
        name: CUST_LOGIN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                 V_CHK NUMBER := 0;
                BEGIN
                 SELECT COUNT(*) INTO V_CHK
                 FROM APP_USERS
                 WHERE USERNAME = :P9999_USERNAME
                 AND PWD = :P9999_PASSWORD 
                 AND NVL(IS_ACTIVE,'N') = 'Y';
                
                 -------------GET USER ROLE NUMBER ---------------
                    BEGIN
                        SELECT USER_ROLE INTO :G_USER_ROLE
                        FROM APP_USERS
                        WHERE USERNAME = :P9999_USERNAME
                        AND PWD = :P9999_PASSWORD 
                        AND NVL(IS_ACTIVE,'N') = 'Y';
                    EXCEPTION
                        WHEN OTHERS THEN 
                          :G_USER_NO := 0;
                    END;
                 -------------------------------------------------
                
                
                 IF V_CHK = 1 THEN 
                    --- LET USER TO LOGIIN 
                    apex_authentication.login(
                                                p_username => :P9999_USERNAME,
                                                p_password => :P9999_PASSWORD
                                                    );
                 ELSE
                    --- SHOW ERROR 
                    apex_error.add_error (
                                                p_message          => '<span> Username or Password Incorrect!</span>',
                                                p_display_location =>  apex_error.c_inline_with_field_and_notif,
                                                p_page_item_name   => 'P9999_PASSWORD'
                                        );
                 END IF;
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 15993761527037021140
        }
        serverSideCondition {
            type: never
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P9999_USERNAME := apex_authentication.get_login_username_cookie;
                :P9999_REMEMBER := case when :P9999_USERNAME is not null then 'Y' end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12963306904614155610
        }
    )

    process login (
        name: Login
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.login(
                    p_username => :P9999_USERNAME,
                    p_password => :P9999_PASSWORD );
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 12963306152023155610
        }
        serverSideCondition {
            type: never
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                APEX_AUTHENTICATION.LOGIN(
                P_USERNAME => :P9999_USERNAME,
                P_PASSWORD => :P9999_PASSWORD
                );
                BEGIN
                SELECT USER_ID 
                INTO :SESSION_GROUP_ID
                FROM GUSER
                WHERE UPPER(USER_NAME) = UPPER(:P9999_USERNAME)
                AND USER_PASS  = :P9999_PASSWORD;
                -- :Global_value:='Halima';
                -- :Global_doc_id:=700;
                SELECT GROUP_ID INTO :G_USER_grp
                FROM USER_GROUP
                WHERE USER_ID= :SESSION_GROUP_ID;
                EXCEPTION
                WHEN OTHERS THEN NULL;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 20685671998519729140
        }
        serverSideCondition {
            whenButtonPressed: @login
        }
        comments {
            comments: commented out only to check login with google
        }
    )

    process set-username-cookie (
        name: Set Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.send_login_username_cookie (
                    p_username => lower(:P9999_USERNAME),
                    p_consent  => :P9999_REMEMBER = 'Y' );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12963306571173155610
        }
        serverSideCondition {
            whenButtonPressed: @login
        }
    )

    branch (
        name: to reset pass
        execution {
            sequence: 10
        }
        behavior {
            target: {
