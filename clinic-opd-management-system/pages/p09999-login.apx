page 9999 (
    name: Login Page
    alias: LOGIN
    title: Clinic OPD Management System - Sign In
    appearance {
        pageTemplate: @login-spider
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /* ENTER BUTTON */
            $('body').on('keydown','input,select,textarea',function(e){
            var self = $(this)
            , form = self.parents('form:eq(0)')
            , focusable
            , next
            ;
            if (e.keyCode == 13){
            focusable = form.find('input,a,select,button,textarea').filter(':visible');
            next = focusable.eq(focusable.index(this)+1);
            if (next.length){
            next.focus();
            }else {
            form.submit();
            }
            return false;
            }
            });
            
            
            function stFocus(evt, PageItem) {
                var e = evt || window.event;
                var key = e.keyCode || e.which;
            	if (key == 13 || key == 9) {
            		//document.getElementById(PageItem).focus();
            		 apex.item( PageItem ).setFocus();
            	}
            }
            
            ```
    }
    css {
