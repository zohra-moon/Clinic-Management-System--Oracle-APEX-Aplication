page 69 (
    name: Appointment Management
    alias: APPOINTMENT-MANAGEMENT
    title: Appointment Management
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region appointment-management (
        name: Appointment Management
        type: form
        source {
            location: localDatabase
            tableName: APPOINTMENT_INFO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P69_APP_DATE_TIME (
        type: datePicker
        label {
            label: App Date Time
            alignment: right
        }
        layout {
            sequence: 20
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @appointment-management
            column: APP_DATE_TIME
            dataType: date
        }
    )

    pageItem P69_APP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @appointment-management
            slot: regionBody
        }
        source {
            formRegion: @appointment-management
            column: APP_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P69_APP_MOBILE_NO (
        type: textField
        label {
            label: App Mobile No
            alignment: right
        }
        layout {
            sequence: 60
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 15
        }
        source {
            formRegion: @appointment-management
            column: APP_MOBILE_NO
            dataType: varchar2
        }
    )

    pageItem P69_APP_SERIAL_NO (
        type: numberField
        label {
            label: App Serial No
            alignment: right
        }
        layout {
            sequence: 30
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @appointment-management
            column: APP_SERIAL_NO
            dataType: number
        }
    )

    pageItem P69_DEPT_ID (
        type: numberField
        label {
            label: Dept Id
            alignment: right
        }
        layout {
            sequence: 170
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
