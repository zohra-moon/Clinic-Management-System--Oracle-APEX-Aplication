        }
        source {
            formRegion: @appointment-management
            column: DEPT_ID
            dataType: number
        }
    )

    pageItem P69_DOC_ID (
        type: selectList
        label {
            label: Doc Id
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @doctors-info-doc-name
        }
        layout {
            sequence: 160
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
