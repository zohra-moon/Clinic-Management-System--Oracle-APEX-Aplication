            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @appointment-management
            column: INSERT_BY
            dataType: varchar2
        }
    )

    pageItem P69_INSERT_DATE (
        type: datePicker
        label {
            label: Insert Date
            alignment: right
        }
        layout {
            sequence: 130
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @appointment-management
            column: INSERT_DATE
            dataType: date
        }
    )

    pageItem P69_NOTE (
        type: textarea
        label {
            label: Note
            alignment: right
        }
        layout {
            sequence: 100
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @appointment-management
            column: NOTE
            dataType: varchar2
        }
    )

    pageItem P69_PATIENT_TYPE (
        type: textField
        label {
            label: Patient Type
            alignment: right
        }
        layout {
            sequence: 80
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @appointment-management
            column: PATIENT_TYPE
            dataType: varchar2
        }
    )

    pageItem P69_P_REG_ID (
        type: selectList
        label {
            label: P Reg Id
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @patients-reg-info-p-name
        }
        layout {
            sequence: 40
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @appointment-management
