            alignment: right
        }
        layout {
            sequence: 90
            region: @appointment-management
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @appointment-management
            column: SERIAL_NO
            dataType: number
        }
    )

    pageItem P69_STATUS (
        type: textField
