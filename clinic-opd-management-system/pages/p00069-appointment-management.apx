        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @appointment-management
            column: RESCHEDULE
            dataType: date
        }
    )

    pageItem P69_SERIAL_NO (
        type: numberField
