page 20 (
    name: Appointments
    alias: APPOINTMENTS
    title: Appointments
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* ===== Page Background (Light Blue Gradient) ===== */
            .t-Body-mainContent {
                flex-grow: 1;
                background: linear-gradient(to bottom right, #cceaff, #99ddff); /* Soft cyan shades */
            }
            
            /* ===== Classic Report & Interactive Grid (Light Shades) ===== */
            .t-Report-report, .a-IRR-table {
                background: rgba(255, 255, 255, 0.9); /* Light Background */
                border-radius: 10px;
                padding: 12px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                border: 1px solid rgba(0, 0, 0, 0.15);
            }
            
            /* ===== Table Borders & Cell Styles ===== */
            .t-Report-report td, 
            .a-IRR-table td {
                border: 1px solid rgba(0, 0, 0, 0.15);
                padding: 10px;
                color: #1e3a5f; /* Deep Blue Text */
                font-size: 14px;
            }
            
            /* ===== Report Header (Stylish Blue Gradient) ===== */
            .a-IRR-header, .a-IRR-header:hover, .t-Report-colHead {
                font-weight: bold;
                color: white;
                background: linear-gradient(135deg, #0072ff, #00c6ff); /* Blue Gradient */
                height: 32px;
                border-radius: 6px;
            }
            
            /* ===== Buttons Styling (Blue & Cyan Glow) ===== */
            #save, #btn_submit, #update {
                background: linear-gradient(310deg, #0072ff, #00c6ff);
                color: white;
                border-radius: 6px;
                font-weight: bold;
                padding: 10px 14px;
                border: none;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(0, 114, 255, 0.3);
                transition: 0.3s ease;
            }
            
            #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(310deg, #0057cc, #009ec6);
                box-shadow: 0 6px 12px rgba(0, 114, 255, 0.5);
            }
            
            /* ===== Close/Cancel Buttons (Red-Blue Mix) ===== */
            #close, #btn_cancel {
                background: linear-gradient(310deg, #ff1100, #3b4f7b);
                transition: 0.3s ease;
            }
            
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(310deg, #c70000, #1f3559);
            }
            
            /* ===== Input Fields - Modern Glow Effect ===== */
            input[type="text"], input[type="number"], input[type="date"], select {
                background: rgba(255, 255, 255, 0.95);
                border: 1px solid #009ec6;
                border-radius: 6px;
                padding: 8px;
                font-size: 14px;
                color: #1e3a5f;
                transition: 0.3s ease-in-out;
            }
            
            input[type="text"]:focus, 
            input[type="number"]:focus, 
            input[type="date"]:focus, 
            select:focus {
                outline: none;
                border: 2px solid #0072ff;
                box-shadow: 0 0 10px rgba(0, 114, 255, 0.4);
            }
            
            /* ===== Date Picker Styling ===== */
            .ui-datepicker {
                background: rgba(255, 255, 255, 0.9);
                border: 2px solid #009ec6;
                border-radius: 10px;
                padding: 6px;
            }
            
            .a-Icon.icon-calendar {
                color: white;
            }
            
            /* ===== Navigation Bar (Elegant Cyan Glow) ===== */
            .t-NavigationBar {
                border: 2px solid white;
                background: rgba(0, 0, 0, 0.5);
                box-shadow: 0 -6px 10px -5px #0072ff, 0 6px 10px -5px #00c6ff;
                border-radius: 20px;
            }
            
            /* ===== Interactive Report Toolbar (Soft Cyan Background) ===== */
            .a-IRR-toolbar {
                background: rgba(255, 255, 255, 0.9);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }
            
            /* ===== Modal/Dialog Boxes ===== */
            .ui-dialog {
                background: rgba(255, 255, 255, 0.95);
                border-radius: 12px;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
            }
            
            /* ===== Hover Effects ===== */
            .t-Button:hover {
                transform: scale(1.05);
            }
            
            .t-Report-report tr:hover, .a-IRR-table tr:hover {
                background: rgba(0, 114, 255, 0.1);
                transition: 0.3s ease;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Report 1
        type: classicReport
        source {
            location: localDatabase
            tableName: APPOINTMENT_INFO
        }
        orderBy {
            type: staticValue
            orderByClause: app_id desc
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: nextAndPreviousLinks
        }
        download {
            csvExportEnabled: true
        }

        column APP_DATE_TIME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: App Date Time
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column APP_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 22
                    items: {
                        P22_APP_ID: \#APP_ID#\
                    }
                    action: resetPagination
                }
                linkText: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column APP_MOBILE_NO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: App Mobile No
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column APP_SERIAL_NO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: App Serial No
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column DEPT_ID (
            reportColumnQueryId: 17
            derivedColumn: N
            heading {
                heading: Dept Id
                alignment: end
            }
            layout {
                sequence: 17
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column DOC_ID (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: Doc Id
                alignment: end
            }
            layout {
                sequence: 16
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column DOC_SH_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Doc Sh Id
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column INSERT_BY (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Insert By
            }
            layout {
                sequence: 12
            }
            sorting {
                sortable: false
            }
        )

        column INSERT_DATE (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Insert Date
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column NOTE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column PATIENT_TYPE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Patient Type
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column P_REG_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Patient
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column RESCHEDULE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Reschedule
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column SERIAL_NO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Serial No
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 11
            }
            sorting {
                sortable: false
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Update By
            }
            layout {
                sequence: 14
            }
            sorting {
                sortable: false
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 15
            derivedColumn: N
            heading {
                heading: Update Date
                alignment: center
            }
            layout {
                sequence: 15
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                clearCache: 22
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

