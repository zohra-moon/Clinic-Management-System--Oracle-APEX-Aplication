page 6 (
    name: List of Employees
    alias: LIST-OF-EMPLOYEES
    title: List of Employees
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* General Page Styling */
            .t-Body-mainContent {
                background: #FEFBE0;
                color: #004d40;
            }
            
            /* Static Region Styling */
            .t-Region {
                background: #e2ece9;
                border-radius: 10px;
                padding: 14px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Table Styling */
            .t-IRR-table, .a-IG-table {
                background: e2ece9;
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #B6D0E2;
            }
            .t-Report-report td, .a-IRR-table td, .a-IG-table td {
                border: 1px solid #B6D0E2;
                padding: 12px;
                color: #000000;
            }
            
            /* Toolbar Styling */
            .a-IRR-toolbar {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 10px;
                padding: 8px;
                box-shadow: 0 4px 8px rgba(182, 208, 226, 0.5);
            }
            
            /* Buttons */
            .t-Button, #save, #btn_submit, #update {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                color: #333;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                transition: 0.3s;
            }
            .t-Button:hover, #save:hover, #btn_submit:hover, #update:hover {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
            }
            #close, #btn_cancel {
                background: linear-gradient(135deg, #FFAAAA, #FF6666);
                color: white;
            }
            #close:hover, #btn_cancel:hover {
                background: linear-gradient(135deg, #FF6666, #CC4444);
            }
            
            /* Input Fields */
            .input-container input, .input-container select {
                width: 100%;
                background: #f6dede;
                border: 1px solid #B6D0E2;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #4A4A4A;
            }
            
            /* Modal/Dialog */
            .ui-dialog {
                background: #FFFFFF;
                border-radius: 10px;
                padding: 16px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 4px 12px rgba(182, 208, 226, 0.5);
            }
            
            /* ===== ¿ Mega Menu Styling ===== */
            .t-MegaMenu {
                background: linear-gradient(135deg, #FEFBE0, #B6D0E2);
                border-radius: 12px;
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
               /* padding: 8px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-item {
                font-weight: bold;
                color: white;
               /* padding: 12px 16px;*/
                border-radius: 8px;
                transition: all 0.3s ease-in-out;
            }
            
            .t-MegaMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 10px rgba(0, 255, 255, 0.5);
                transform: scale(1.05);
            }
            
            .t-MegaMenu .is-hover .t-MegaMenu-subMenu {
                background: rgba(0, 0, 0, 0.8);
                border-radius: 10px;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item {
                color: white;
                background: transparent;
                /*padding: 10px 14px;*/
            }
            
            .t-MegaMenu .t-MegaMenu-subMenu .t-MegaMenu-item:hover {
                background: rgba(255, 255, 255, 0.2);
                color: cyan;
                border-radius: 6px;
                transform: translateX(4px);
            }
            
            .t-MegaMenu .t-MegaMenu-item.is-active {
                background: #e2ece9;
                color: white;
                box-shadow: 0 4px 8px rgba(0, 188, 212, 0.4);
            }
            
            
            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-thumb {
                background: #B6D0E2;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #A0B8C8;
            }
            
            /* Hover Effects */
            .t-Report-report tr:hover td, .a-IRR-table tr:hover td {
                background: #B6D0E2;
                transition: 0.3s;
            }
            
            /* Breadcrumb Bar Styling */
            .t-BreadcrumbRegion {
                background: linear-gradient(135deg, #B6D0E2, #FEFBE0);
                border-radius: 8px;
                padding: 10px;
                border: 1px solid #B6D0E2;
                box-shadow: 0 2px 6px rgba(182, 208, 226, 0.5);
            }
            .t-BreadcrumbRegion .t-Breadcrumb-label {
                color: #004d40;
                font-weight: bold;
            }
            .t-BreadcrumbRegion a {
                color: #006064;
                text-decoration: none;
                transition: 0.3s;
            }
            .t-BreadcrumbRegion a:hover {
                color: #004d40;
                text-decoration: underline;
            }
            
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region list-of-employees (
        name: List of Employees
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
            icon: fa-user
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region report (
        name: Report 1
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EMP_ID,
                       EMP_NAME,
                       ADDRESS,
                       NID_NO,
                       MOBILE_NO,
                       EMAIL,
                       EMP_HIRE_DATE,
                       RESIGN_DATE,
                       EMP_IMAGE,
                       MIMETYPE,
                       FILENAME,
                       IMAGE_LAST_UPDATE,
                       DEPT_ID,
                       DG_ID,
                       SALARY,
                       STATUS,
                       INSERT_BY,
                       INSERT_DATE,
                       UPDATE_BY,
                       UPDATE_DATE,
                       DIV_NO,
                       DIST_NO,
                      PS_UPAZILA_NO,
                       UNION_NO,
                   'edit' edit, 'show' show
                    
                    FROM 
                       employees_INFO 
                 
                order by 1;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }

        column ADDRESS (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column DEPT_ID (
            reportColumnQueryId: 13
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Department
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @departments
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

        column DG_ID (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 100
            }
        )

        column DIST_NO (
            reportColumnQueryId: 22
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column DIV_NO (
            reportColumnQueryId: 21
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

        column EDIT (
            reportColumnQueryId: 25
            derivedColumn: N
            type: link
            heading {
                heading: Edit
                alignment: center
            }
            layout {
                sequence: 260
                columnAlignment: center
            }
            link {
                target: {
                    page: 3
                    items: {
                        P3_EMP_ID: #EMP_ID#
                    }
                    clearCache: 16
                }
                linkText: <span class="fa fa-edit" aria-hidden="true"></span>
            }
            sorting {
                sortable: false
            }
        )

        column EMAIL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Email
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column EMP_HIRE_DATE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Hire Date
                alignment: center
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            sorting {
                sortable: false
            }
        )

        column EMP_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column EMP_IMAGE (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column EMP_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column FILENAME (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 180
            }
        )

        column IMAGE_LAST_UPDATE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

        column INSERT_BY (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hidden
            layout {
                sequence: 210
            }
        )

        column INSERT_DATE (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hidden
            layout {
                sequence: 220
            }
        )

        column MIMETYPE (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column MOBILE_NO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column NID_NO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column PS_UPAZILA_NO (
            reportColumnQueryId: 23
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column RESIGN_DATE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column SALARY (
            reportColumnQueryId: 15
            derivedColumn: N
            heading {
                heading: Salary
                alignment: center
            }
            layout {
                sequence: 110
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column SHOW (
            reportColumnQueryId: 26
            derivedColumn: N
            type: link
            heading {
                heading: Show
                alignment: center
            }
            layout {
                sequence: 270
                columnAlignment: center
            }
            link {
                target: {
                    page: 21
                    items: {
                        P21_EMP_ID: #EMP_ID#
                    }
                }
                linkText: <span class="fa fa-file-text-o" aria-hidden="true"></span>
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 16
            derivedColumn: N
            type: hidden
            layout {
                sequence: 200
            }
        )

        column UNION_NO (
            reportColumnQueryId: 24
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 230
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 20
            derivedColumn: N
            type: hidden
            layout {
                sequence: 240
            }
        )

    )

    button add-btn-extra (
        buttonName: Add_btn_extra
        label: "Add New "
        layout {
            sequence: 20
            region: @list-of-employees
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--hoverIconPush
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction auto-ref (
        name: auto ref
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: Window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

