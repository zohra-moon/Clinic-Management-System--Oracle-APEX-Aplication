page 62 (
    name: test
    alias: TEST
    title: test
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: New
        type: classicReport
        source {
            location: localDatabase
            tableName: ADVICE_INFO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ADV_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Adv Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column ADV_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Adv Name
            }
            layout {
                sequence: 20
            }
        )

        column INSERT_BY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Insert By
            }
            layout {
                sequence: 40
            }
        )

        column INSERT_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Insert Date
            }
            layout {
                sequence: 50
            }
        )

        column STATUS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

        column UPDATE_BY (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Update By
            }
            layout {
                sequence: 60
            }
        )

        column UPDATE_DATE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Update Date
            }
            layout {
                sequence: 70
            }
        )

    )

)

