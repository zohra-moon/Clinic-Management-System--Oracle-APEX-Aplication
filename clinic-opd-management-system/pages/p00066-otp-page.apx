page 66 (
    name: OTP Page
    alias: OTP-PAGE
    title: OTP Page
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function maskEmail(email) {
                if (!email || email.indexOf('@') === -1) {
                    return '';
                }
            
                var parts = email.split('@');
                var localPart = parts[0];
                var domain = parts[1];
            
                var lastTwo = localPart.length > 2
                    ? localPart.slice(-2)
                    : localPart;
            
                return '......' + lastTwo + '@' + domain;
            }
            
            document.addEventListener("DOMContentLoaded", function () {
                var email = $v('P66_EMAIL_USER');
                var el = document.getElementById("maskedEmail");
            
                if (!email) {
                    el.textContent = 'No email address found linked to your account';
                    el.className = 'no-email';
                } else {
                    el.textContent = maskEmail(email);
                    el.className = 'masked-email';
                }
            });
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                    .otp-wrapper {
                        margin: 30px auto;
                        padding: 20px 24px;
                        background: linear-gradient(180deg, #f9fbff, #ffffff);
                        border: 1px solid #e3e9f3;
                        border-radius: 12px;
                        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.05);
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
                    }
                
                    .otp-text {
                        font-size: 15px;
                        color: #2b2b2b;
                        line-height: 1.7;
                    }
                
                    .masked-email {
                        display: inline-block;
                        margin-top: 10px;
                        padding: 7px 14px;
                        background: #eef4ff;
                        border: 1px dashed #2c6ed5;
                        border-radius: 8px;
                        font-weight: 600;
                        color: #2c6ed5;
                        letter-spacing: 0.8px;
                        font-size: 14px;
                    }
                
                    .no-email {
                        display: inline-block;
                        margin-top: 10px;
                        padding: 7px 14px;
                        background: #fff4f4;
                        border: 1px solid #f1c0c0;
                        border-radius: 8px;
                        font-weight: 600;
                        color: #b42323;
                        font-size: 14px;
                    }
                </style>
                
                <div class="otp-wrapper">
                    <div class="otp-text">
                        To get a verification OTP, first confirm the email address that you added to your account.
                    </div>
                
                    <span id="maskedEmail"></span>
                </div>
                
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region otp-mail (
        name: OTP Mail
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P66_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        layout {
            sequence: 20
            region: @otp-mail
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Your  Email
        }
    )

    pageItem P66_EMAIL_USER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @otp-mail
            slot: regionBody
        }
    )

    pageItem P66_USER_NAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @otp-mail
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button bt-redirect (
        buttonName: BT_redirect
        label: Go Back to Log in Page
        layout {
            sequence: 50
            region: @otp-mail
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--link
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
                clearCache: 9999
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: Submit
        label: Submit
        layout {
            sequence: 40
            region: @otp-mail
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction disable-mail (
        name: disable mail
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P66_EMAIL_USER
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P66_EMAIL
            }
            execution {
                sequence: 10
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @submit
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction set-session (
        name: set session
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P66_EMAIL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: APEX_UTIL.SET_SESSION_STATE('P66_EMAIL',:P66_EMAIL);
                itemsToSubmit: P66_EMAIL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if :P66_EMAIL_USER <> :P66_EMAIL  then
                return 'Email address doesn’t match the one that you provided. Try again.';
                elsif :P66_EMAIL is null then
                return 'please enter email!';
                
                end if;
                ```
        }
        error {
            associatedItem: @P66_EMAIL
        }
    )

    process gen-otp (
        name: Gen OTP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                l_otp number;
                begin
                l_otp := LPAD(TRUNC(DBMS_RANDOM.VALUE(0,999999)),6,'0');
                
                INSERT INTO app_user_otp(USERNAME, otp_code, expire_at)
                VALUES (:P66_EMAIL, l_otp, SYSDATE + 5/1440);
                
                apex_mail.send(
                 p_to => :P66_EMAIL,
                 p_from => 'kutub@ubs-bd.com',
                 p_subj => 'Your OTP',
                 p_body => 'OTP: ' || l_otp
                );
                apex_mail.push_queue;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 125823394987220314647
        }
    )

    process get-user-mail (
        name: get user mail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select email 
                into :P66_EMAIL_USER
                from GUSER
                where trim(upper(USER_NAME)) = trim(upper(:P66_USER_NAME));
                exception
                when others then :P66_EMAIL_USER :=null;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 128044384787750366532
        }
    )

    branch (
        name: 67
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 67
                items: {
                    P67_EMAIL: &P66_EMAIL.
                }
            }
        }
    )

)

