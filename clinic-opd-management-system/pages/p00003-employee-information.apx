    pageItem P3_PS_UPAZILA_NO (
        type: selectList
        label {
            label: "PS/Upazila "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ps_upazila_name d, ps_upazila_no R
                from ps_upazilas
                where dist_no = :P3_DIST_NO
                order by 1;
                ```
        }
        cascadingLov {
            parentItems: P3_DIST_NO
            itemsToSubmit: P3_DIST_NO
        }
        layout {
            sequence: 230
            region: @employee-information
            slot: regionBody
            alignment: left
        }
        appearance {
