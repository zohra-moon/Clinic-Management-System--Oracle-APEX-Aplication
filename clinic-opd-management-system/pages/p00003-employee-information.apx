    pageItem P3_EMP_HIRE_DATE (
        type: datePicker
        label {
            label: Hire Date
            alignment: left
        }
        layout {
            sequence: 70
            region: @employee-information
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employee-information
            column: EMP_HIRE_DATE
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select sysdate from dual;
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P3_EMP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @employee-information
