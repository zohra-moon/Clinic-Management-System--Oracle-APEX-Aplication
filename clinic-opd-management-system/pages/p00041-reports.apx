    dynamicAction get-doc (
        name: GET doc
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P41_DOC_ID_1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    APEX_UTIL.SET_SESSION_STATE('P41_DOC_ID_1',:P41_DOC_ID_1);
                    END;
                    ```
                itemsToSubmit: P41_DOC_ID_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

