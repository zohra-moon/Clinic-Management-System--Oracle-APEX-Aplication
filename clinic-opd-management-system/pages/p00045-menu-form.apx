page 45 (
    name: menu form
    alias: MENU-FORM
    title: menu form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region menu-form (
        name: menu form
        type: form
        source {
            location: localDatabase
            tableName: MENU
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P45_APEX_PAGE_NO (
        type: selectList
        label {
            label: Apex Page No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PAGE_NAME || ' (P-' || PAGE_ID || ')' AS d, PAGE_ID AS r
                FROM apex_application_pages
                WHERE application_id = :APP_ID;
                ```
        }
        layout {
            sequence: 60
            region: @menu-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @menu-form
            column: APEX_PAGE_NO
            dataType: varchar2
        }
    )

    pageItem P45_COMPANY_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: COMPANY_ID
            dataType: number
        }
    )

    pageItem P45_CREATE_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: CREATE_BY
            dataType: varchar2
        }
    )

    pageItem P45_CREATE_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: CREATE_DATE
            dataType: date
        }
    )

    pageItem P45_DISPLAY_NAME (
        type: hidden
        layout {
            sequence: 40
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: DISPLAY_NAME
            dataType: varchar2
        }
    )

    pageItem P45_FORM_NAME (
        type: hidden
        layout {
            sequence: 30
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: FORM_NAME
            dataType: varchar2
        }
    )

    pageItem P45_MENU_CODE (
        type: hidden
        layout {
            sequence: 10
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: MENU_CODE
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P45_MENU_NAME (
        type: textField
        label {
            label: Menu Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @menu-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @menu-form
            column: MENU_NAME
            dataType: varchar2
        }
    )

    pageItem P45_PARENT_MENU (
        type: selectList
        label {
            label: Parent Menu
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT LPAD(' ', 3 * (LEVEL - 1), '-') || menu_name AS R, 
                       menu_code
                FROM menu
                START WITH parent_menu IS NULL
                CONNECT BY PRIOR menu_code = parent_menu
                ORDER SIBLINGS BY menu_name;
                
                ```
        }
        layout {
            sequence: 50
            region: @menu-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @menu-form
            column: PARENT_MENU
            dataType: varchar2
        }
    )

    pageItem P45_SUB_APEX_PAGE_NO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: SUB_APEX_PAGE_NO
            dataType: varchar2
        }
    )

    pageItem P45_SUB_FORM_NAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: SUB_FORM_NAME
            dataType: varchar2
        }
    )

    pageItem P45_UPDATE_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: UPDATE_BY
            dataType: varchar2
        }
    )

    pageItem P45_UPDATE_DATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @menu-form
            slot: regionBody
        }
        source {
            formRegion: @menu-form
            column: UPDATE_DATE
            dataType: date
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P45_MENU_CODE
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P45_MENU_CODE
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P45_MENU_CODE
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 20523996630583151061
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-menu-form (
        name: Initialize form menu form
        type: formInitialization
        formRegion: @menu-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 20523995839698151060
        }
    )

    process pk (
        name: pk
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select nvl(max( MENU_CODE ),999)+1
                into :P45_MENU_CODE
                from MENU
                order by 1 desc;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20487255817232376230
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-form-menu-form (
        name: Process form menu form
        type: formAutoRowProcessing
        formRegion: @menu-form
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 20523996223487151061
        }
    )

)

